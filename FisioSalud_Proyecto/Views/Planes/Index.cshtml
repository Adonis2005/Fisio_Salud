@model List<FisioSalud_Proyecto.Models.Entities.PlanTratamiento>
@using FisioSalud_Proyecto.Models.Entities
@{ bool esFisio = User.IsInRole("Fisioterapeuta"); Layout = esFisio ? "_LayoutFisioterapeuta" : "_LayoutAdmin"; ViewData["Title"] = "Planes de tratamiento"; var diagnosticos = (List<Diagnostico>)ViewBag.Diagnosticos; }
<div class="fisio-card">
    <h2>Planes de tratamiento</h2>
    <form method="get" class="form-inline mb-3"><input name="busqueda" value="@ViewBag.Busqueda" placeholder="Paciente o plan" class="form-control mr-2"/><select name="estado" class="form-control mr-2"><option value="">Todos los estados</option>@foreach(var estado in new[]{"ACTIVO","PAUSADO","COMPLETADO","CANCELADO"}){<option selected="@(ViewBag.Estado == estado)">@estado</option>}</select><button class="btn btn-primary">Buscar</button></form>
    @if(esFisio) { <a asp-controller="Fisioterapeuta" asp-action="Pacientes" class="btn btn-outline-primary mb-3">Evaluar paciente / registrar diagnóstico</a><button class="btn btn-primary mb-3 ml-2" data-bs-toggle="modal" data-bs-target="#planNuevo" disabled="@(!diagnosticos.Any())">Crear plan</button> }
    @if(!Model.Any()) { <p>No hay planes que coincidan con la búsqueda.</p> }
    @foreach(var plan in Model) {
        <article class="border rounded p-3 mb-3"><h4>@plan.Nombre <small>@plan.Estado</small></h4><p>@plan.Paciente.NombreCompleto · @plan.Fisioterapeuta.NombreCompleto</p><p>@plan.Objetivos</p><p>@plan.FechaInicio.ToString("dd/MM/yyyy") · @plan.DuracionEstimada semanas · @plan.Sesiones.Count sesiones registradas</p>
        @if(esFisio) { <a asp-controller="Fisioterapeuta" asp-action="VerPaciente" asp-route-id="@plan.PacienteId" class="btn btn-outline-primary">Expediente y rutina</a>
            @if(plan.Estado == "ACTIVO" || plan.Estado == "PAUSADO") {
                <button class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editarPlan_@plan.PlanTratamientoId">Editar</button>
                @foreach(var estado in new[]{plan.Estado == "ACTIVO" ? "PAUSADO" : "ACTIVO", "COMPLETADO", "CANCELADO"}) { <form asp-action="Estado" method="post" class="d-inline"><input name="id" type="hidden" value="@plan.PlanTratamientoId"/><input name="estado" type="hidden" value="@estado"/><button class="btn btn-outline-secondary">@estado</button></form> }
                <div class="modal fade" id="editarPlan_@plan.PlanTratamientoId"><div class="modal-dialog"><div class="modal-content"><form asp-action="Guardar" method="post"><div class="modal-header"><h5>Editar plan</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="planTratamientoId" value="@plan.PlanTratamientoId"/><input type="hidden" name="diagnosticoId" value="@plan.DiagnosticoId"/><label>Nombre</label><input name="nombre" value="@plan.Nombre" class="form-control" required maxlength="150"/><label>Objetivos</label><textarea name="objetivos" class="form-control" required maxlength="1000">@plan.Objetivos</textarea><label>Semanas</label><input name="duracionEstimada" value="@plan.DuracionEstimada" type="number" min="1" max="104" required class="form-control"/><label>Inicio</label><input name="fechaInicio" type="date" value="@plan.FechaInicio.ToString("yyyy-MM-dd")" class="form-control" required/></div><div class="modal-footer"><button class="btn btn-primary">Guardar</button></div></form></div></div></div>
            }
        }</article>
    }
</div>
@if(esFisio) {
<div class="modal fade" id="planNuevo"><div class="modal-dialog"><div class="modal-content"><form asp-action="Guardar" method="post"><div class="modal-header"><h5>Crear plan</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label>Paciente y diagnóstico</label><select name="diagnosticoId" required class="form-control">@foreach(var d in diagnosticos){<option value="@d.DiagnosticoId">@d.Paciente.NombreCompleto — @d.DiagnosticoTexto</option>}</select><label>Nombre</label><input name="nombre" class="form-control" required maxlength="150"/><label>Objetivos</label><textarea name="objetivos" class="form-control" required maxlength="1000"></textarea><label>Semanas</label><input name="duracionEstimada" type="number" min="1" max="104" value="8" class="form-control" required/><label>Inicio</label><input name="fechaInicio" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" required/></div><div class="modal-footer"><button class="btn btn-primary">Crear plan</button></div></form></div></div></div>
}
