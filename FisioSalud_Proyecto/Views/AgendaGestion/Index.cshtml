@model FisioSalud_Proyecto.Controllers.GestionAgendaViewModel
@{ bool esAdmin=User.IsInRole("Administrador"); Layout=esAdmin?"_LayoutAdmin":User.IsInRole("Fisioterapeuta")?"_LayoutFisioterapeuta":"_LayoutCliente"; ViewData["Title"]="Gestión de agenda"; }
<div class="card p-4"><h2>Gestión de agenda</h2><p>Reprograma conservando terapeuta, duración, factura y pago. Se comprueba la disponibilidad y se impiden cruces.</p>
@if(esAdmin){
<details class="mb-4"><summary>Agendar una cita desde recepción</summary><form asp-action="Crear" method="post" class="mt-3"><label>Paciente</label><select name="pacienteId" class="form-control" required>@foreach(var p in Model.Pacientes){<option value="@p.PacienteId">@p.NombreCompleto</option>}</select><label>Terapeuta</label><select name="FisioterapeutaId" class="form-control" required>@foreach(var t in Model.Terapeutas){<option value="@t.UsuarioId">@t.NombreCompleto</option>}</select><label>Servicio y tarifa</label><select name="Servicio" class="form-control" required>@foreach(var s in Model.Servicios){<option value="@s.Nombre">@s.Nombre · @s.Precio.ToString("C2")</option>}</select><label>Fecha</label><input type="date" name="Fecha" class="form-control" required/><label>Hora</label><input type="time" name="Hora" class="form-control" required/><label>Motivo</label><textarea name="Mensaje" class="form-control" maxlength="500"></textarea><button class="btn btn-primary mt-2">Agendar y generar factura</button></form></details>
}
@if(!Model.Reservas.Any()){<p>No hay citas abiertas que se puedan reprogramar.</p>}
@foreach(var cita in Model.Reservas){<article class="border rounded p-3 mb-3"><h5>@cita.Paciente.NombreCompleto · @cita.Fisioterapeuta.NombreCompleto</h5><p>@cita.Fecha.ToString("dd/MM/yyyy") @cita.HoraInicio.ToString(@"hh\:mm") · @cita.Estado · @cita.MotivoConsulta</p><details><summary>Cambiar fecha y hora</summary><form asp-action="Reprogramar" method="post"><input type="hidden" name="citaId" value="@cita.CitaId"/><label>Nueva fecha</label><input name="fecha" type="date" class="form-control" value="@cita.Fecha.ToString("yyyy-MM-dd")" required/><label>Nueva hora</label><input name="hora" type="time" class="form-control" value="@cita.HoraInicio.ToString(@"hh\:mm")" required/><label>Motivo del cambio</label><input name="motivo" class="form-control" required maxlength="250"/><button class="btn btn-primary mt-2">Guardar reprogramación</button></form></details></article>}
</div>
