@model FacturasPageViewModel
@{
    Layout = "_LayoutCliente";
    ViewData["Title"] = "Mis Facturas y Cobros";
}

<div class="fs-card mb-4"><p>Reporta aquí el pago realizado por transferencia o en recepción. Administración comprobará el ingreso antes de confirmar tu cita. No se cargan tarjetas desde esta pantalla.</p><a asp-controller="Cobros" asp-action="Index" class="btn btn-outline-primary">Ver estado de mis comprobantes</a></div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
    <div class="fs-card">
        <div class="text-sm text-terracotta">Total pagado</div>
        <div class="text-3xl font-bold my-1 text-emerald-700">@Model.TotalPagado.ToString("C0")</div>
        <div class="text-xs text-terracotta">Facturas liquidadas</div>
    </div>
    <div class="fs-card">
        <div class="text-sm text-terracotta">Total pendiente por pagar</div>
        <div class="text-3xl font-bold my-1 text-amber-700">@Model.TotalPendiente.ToString("C0")</div>
        <div class="text-xs text-terracotta">Facturas abiertas o por vencer</div>
    </div>
</div>

<section class="fs-card">
    <div class="flex justify-between items-center mb-4">
        <h3 class="mb-0">Historial de Facturación</h3>
        <span class="text-xs text-terracotta">Total de comprobantes: @Model.Facturas.Count</span>
    </div>

    @if (!Model.Facturas.Any())
    {
        <div class="text-center py-8">
            <i class="bi bi-receipt text-4xl opacity-40 block mb-2"></i>
            <p class="font-semibold text-sm mb-1">No tienes facturas emitidas en tu expediente.</p>
            <p class="text-xs text-terracotta mb-0">Cuando la clínica emita un comprobante o recibo de tus sesiones, aparecerá registrado en esta sección.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-terracotta border-b border-espresso/10">
                        <th class="pb-3">Nº Factura</th>
                        <th class="pb-3">Fecha</th>
                        <th class="pb-3">Especialista / Emisor</th>
                        <th class="pb-3 text-right">Monto</th>
                        <th class="pb-3 text-center">Estado</th>
                        <th class="pb-3 text-center">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model.Facturas)
                    {
                        <tr class="border-b border-espresso/5 hover:bg-espresso/5">
                            <td class="py-3 font-semibold">@f.NumeroFactura</td>
                            <td>@f.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@f.Fisioterapeuta</td>
                            <td class="text-right font-bold">@f.Monto.ToString("C2")</td>
                            <td class="text-center">
                                <span class="badge-soft @f.EstadoClass">@f.Estado</span>
                            </td>
                            <td class="text-center">
                                @if (string.Equals(f.Estado, "PENDIENTE", StringComparison.OrdinalIgnoreCase))
                                {
                                    <button type="button" class="btn btn-sm btn-success rounded-pill px-3 py-1 text-xs" data-bs-toggle="modal" data-bs-target="#modalPago_@f.FacturaId">
                                        <i class="bi bi-credit-card me-1"></i> Pagar
                                    </button>

                                    <!-- Modal Pago -->
                                    <div class="modal fade" id="modalPago_@f.FacturaId" tabindex="-1">
                                        <div class="modal-dialog modal-dialog-centered text-start">
                                            <div class="modal-content">
                                                <form asp-action="RegistrarPago" method="post">
                                                    <input type="hidden" name="FacturaId" value="@f.FacturaId" />
                                                    <input type="hidden" name="NumeroFactura" value="@f.NumeroFactura" />
                                                    <input type="hidden" name="Monto" value="@f.Monto" />
                                                    <div class="modal-header">
                                                        <h5 class="modal-title font-bold">Registrar Pago de Factura</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <div class="mb-3">
                                                            <label class="form-label text-xs font-bold">Factura Nº</label>
                                                            <input type="text" class="form-control form-control-sm" value="@f.NumeroFactura" readonly />
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label text-xs font-bold">Monto a Pagar</label>
                                                            <input type="text" class="form-control form-control-sm" value="@f.Monto.ToString("C2")" readonly />
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label text-xs font-bold">Método de Pago</label>
                                                            <select name="MetodoPago" class="form-select form-select-sm" required>
                                                                <option value="Transferencia">Transferencia Bancaria</option>
                                                                <option value="Tarjeta">Tarjeta de Crédito/Débito</option>
                                                                <option value="Efectivo">Efectivo en Ventanilla</option>
                                                            </select>
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label text-xs font-bold">Número de Referencia / Depósito</label>
                                                            <input type="text" name="Referencia" class="form-control form-control-sm" placeholder="ej. TR-982173" required />
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancelar</button>
                                                        <button type="submit" class="btn btn-sm btn-success">Enviar comprobante a revisión</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xs text-muted"><i class="bi bi-check-circle-fill text-success me-1"></i> Pagado</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
