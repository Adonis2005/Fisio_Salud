@model FisioSalud_Proyecto.Models.Administrador.AdminReportesPageViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Generador de Reportes";
}

<div class="row g-3">
    <!-- Columna Principal de Configuración de Reporte -->
    <div class="col-12 col-xl-8">
        <form asp-action="GenerarReporte" method="post" id="formReportes">
            @Html.AntiForgeryToken()

            <!-- 1. Selecciona el tipo de reporte -->
            <div class="fisio-card mb-3">
                <h5 class="fw-bold mb-3" style="font-size:0.95rem; color:#1e293b;">1. Selecciona el tipo de reporte</h5>
                <div class="report-type-grid mb-3">
                    <div class="report-type-card active" data-desc="Ingresos, gastos, facturas pendientes y análisis de rentabilidad" data-type="financiero">
                        <input type="radio" name="tipo" value="financiero" checked style="display:none;" />
                        <div class="report-icon-circle blue"><i class="bi bi-receipt"></i></div>
                        <div class="report-type-title">Financiero y Facturación</div>
                    </div>
                    <div class="report-type-card" data-desc="Evolución clínica, historias de pacientes, diagnósticos y altas" data-type="clinico">
                        <input type="radio" name="tipo" value="clinico" style="display:none;" />
                        <div class="report-icon-circle cyan"><i class="bi bi-people-fill"></i></div>
                        <div class="report-type-title">Clínico y Pacientes</div>
                    </div>
                    <div class="report-type-card" data-desc="Rendimiento del personal, horas trabajadas y ocupación de salas" data-type="operacional">
                        <input type="radio" name="tipo" value="operacional" style="display:none;" />
                        <div class="report-icon-circle green"><i class="bi bi-person-gear"></i></div>
                        <div class="report-type-title">Operacional y Personal</div>
                    </div>
                    <div class="report-type-card" data-desc="Evaluaciones de calidad, NPS y encuestas de satisfacción" data-type="satisfaccion">
                        <input type="radio" name="tipo" value="satisfaccion" style="display:none;" />
                        <div class="report-icon-circle yellow"><i class="bi bi-star-fill"></i></div>
                        <div class="report-type-title">Satisfacción y Calidad</div>
                    </div>
                    <div class="report-type-card" data-desc="Adherencia a tratamientos, asistencia a citas y programas" data-type="cumplimiento">
                        <input type="radio" name="tipo" value="cumplimiento" style="display:none;" />
                        <div class="report-icon-circle pink"><i class="bi bi-shield-check"></i></div>
                        <div class="report-type-title">Cumplimiento y Tratamiento</div>
                    </div>
                </div>

                <div class="report-desc-strip" id="reportDescStrip">
                    Ingresos, gastos, facturas pendientes y análisis de rentabilidad
                </div>
            </div>

            <!-- 2. Selecciona las métricas a incluir -->
            <div class="fisio-card mb-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold m-0" style="font-size:0.95rem; color:#1e293b;">2. Selecciona las métricas a incluir</h5>
                    <button type="button" class="btn btn-link p-0 text-decoration-none fw-bold" id="selectAllBtn" style="font-size:0.8rem; color:#4A6CF7;">Seleccionar todo</button>
                </div>

                <div class="metric-pill-grid">
                    <label class="metric-pill-item">
                        <input type="checkbox" name="metricas" value="ingresos_total" class="chk-metric" />
                        <span>Total de ingresos del período</span>
                    </label>
                    <label class="metric-pill-item">
                        <input type="checkbox" name="metricas" value="ingresos_terapeuta" class="chk-metric" />
                        <span>Ingresos por terapeuta</span>
                    </label>
                    <label class="metric-pill-item">
                        <input type="checkbox" name="metricas" value="facturas_estado" class="chk-metric" />
                        <span>Facturas emitidas / pagadas / vencidas</span>
                    </label>
                    <label class="metric-pill-item">
                        <input type="checkbox" name="metricas" value="comparativo_anterior" class="chk-metric" />
                        <span>Comparativo vs período anterior</span>
                    </label>
                    <label class="metric-pill-item">
                        <input type="checkbox" name="metricas" value="proyeccion_mensual" class="chk-metric" />
                        <span>Proyección mensual</span>
                    </label>
                    <label class="metric-pill-item">
                        <input type="checkbox" name="metricas" value="desglose_servicio" class="chk-metric" />
                        <span>Desglose por tipo de servicio</span>
                    </label>
                </div>
            </div>

            <!-- 3. Período y formato -->
            <div class="fisio-card mb-3">
                <h5 class="fw-bold mb-3" style="font-size:0.95rem; color:#1e293b;">3. Período y formato</h5>
                <div class="row g-3 align-items-end mb-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label text-muted fw-semibold mb-1" style="font-size:0.75rem;">Fecha inicio</label>
                        <input type="date" name="fechaInicio" value="@Model.FechaInicio.ToString("yyyy-MM-dd")" class="form-control rounded-pill px-3" style="font-size:0.82rem; background:#f1f5f9; border:none;" required />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label text-muted fw-semibold mb-1" style="font-size:0.75rem;">Fecha fin</label>
                        <input type="date" name="fechaFin" value="@Model.FechaFin.ToString("yyyy-MM-dd")" class="form-control rounded-pill px-3" style="font-size:0.82rem; background:#f1f5f9; border:none;" required />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label text-muted fw-semibold mb-1 d-block" style="font-size:0.75rem;">Formato de exportación</label>
                        <input type="hidden" name="formato" id="inputFormato" value="csv" />
                        <div class="format-btn-group w-100 justify-content-between">
                            <button type="button" class="btn-fmt" data-fmt="pdf">PDF</button>
                            <button type="button" class="btn-fmt" data-fmt="excel">Excel</button>
                            <button type="button" class="btn-fmt active" data-fmt="csv">CSV</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Botón Generar Reporte -->
            <div class="text-center">
                <button type="submit" class="btn-generate-main disabled" id="btnGenerate">
                    <i class="bi bi-download"></i>
                    <span id="btnGenerateText">Generar reporte (0 métricas)</span>
                </button>
                <div class="text-muted mt-2" id="btnSubtext" style="font-size:0.75rem;">Selecciona al menos una métrica para continuar</div>
            </div>
        </form>
    </div>

    <!-- Columna Lateral: Reportes Recientes & Automáticos -->
    <div class="col-12 col-xl-4">
        <!-- Reportes Recientes -->
        <div class="fisio-card mb-3">
            <h5 class="fw-bold mb-3" style="font-size:0.95rem; color:#1e293b;">Reportes Recientes</h5>
            <div class="text-muted fw-semibold mb-2" style="font-size:0.75rem;">Historial de reportes</div>

            <div class="d-flex flex-column">
                <div class="history-item">
                    <div class="d-flex align-items-center gap-2">
                        <div class="history-icon-box"><i class="bi bi-file-earmark-pdf"></i></div>
                        <div>
                            <div class="fw-bold" style="font-size:0.8rem; color:#1e293b;">Reporte Mensual de Ingresos — Junio 2026</div>
                            <div class="text-muted" style="font-size:0.7rem;">1 jul 2026 · 2.4 MB <span class="badge bg-info text-dark ms-1" style="font-size:0.65rem;">PDF</span></div>
                        </div>
                    </div>
                    <a href="#" class="icon-action text-muted" title="Descargar"><i class="bi bi-download"></i></a>
                </div>

                <div class="history-item">
                    <div class="d-flex align-items-center gap-2">
                        <div class="history-icon-box excel"><i class="bi bi-file-earmark-excel"></i></div>
                        <div>
                            <div class="fw-bold" style="font-size:0.8rem; color:#1e293b;">Ocupación de Terapeutas — Q2 2026</div>
                            <div class="text-muted" style="font-size:0.7rem;">30 jun 2026 · 1.1 MB <span class="badge bg-success ms-1" style="font-size:0.65rem;">Excel</span></div>
                        </div>
                    </div>
                    <a href="#" class="icon-action text-muted" title="Descargar"><i class="bi bi-download"></i></a>
                </div>

                <div class="history-item">
                    <div class="d-flex align-items-center gap-2">
                        <div class="history-icon-box"><i class="bi bi-file-earmark-pdf"></i></div>
                        <div>
                            <div class="fw-bold" style="font-size:0.8rem; color:#1e293b;">Satisfacción de Pacientes — Mayo 2026</div>
                            <div class="text-muted" style="font-size:0.7rem;">1 jun 2026 · 820 KB <span class="badge bg-info text-dark ms-1" style="font-size:0.65rem;">PDF</span></div>
                        </div>
                    </div>
                    <a href="#" class="icon-action text-muted" title="Descargar"><i class="bi bi-download"></i></a>
                </div>

                <div class="history-item">
                    <div class="d-flex align-items-center gap-2">
                        <div class="history-icon-box"><i class="bi bi-file-earmark-pdf"></i></div>
                        <div>
                            <div class="fw-bold" style="font-size:0.8rem; color:#1e293b;">Alta de Nuevos Pacientes — Junio 2026</div>
                            <div class="text-muted" style="font-size:0.7rem;">1 jun 2026 · 650 KB <span class="badge bg-info text-dark ms-1" style="font-size:0.65rem;">PDF</span></div>
                        </div>
                    </div>
                    <a href="#" class="icon-action text-muted" title="Descargar"><i class="bi bi-download"></i></a>
                </div>

                <div class="history-item">
                    <div class="d-flex align-items-center gap-2">
                        <div class="history-icon-box excel"><i class="bi bi-file-earmark-excel"></i></div>
                        <div>
                            <div class="fw-bold" style="font-size:0.8rem; color:#1e293b;">Facturación Pendiente — Q2 2026</div>
                            <div class="text-muted" style="font-size:0.7rem;">28 jun 2026 · 980 KB <span class="badge bg-success ms-1" style="font-size:0.65rem;">Excel</span></div>
                        </div>
                    </div>
                    <a href="#" class="icon-action text-muted" title="Descargar"><i class="bi bi-download"></i></a>
                </div>
            </div>
        </div>

        <!-- Reportes automáticos programados -->
        <div class="fisio-card mb-0">
            <h5 class="fw-bold mb-3" style="font-size:0.95rem; color:#1e293b;">Reportes automáticos programados</h5>

            <div class="d-flex flex-column gap-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="fw-bold" style="font-size:0.82rem; color:#1e293b;">Ingresos semanales</div>
                        <div class="text-muted" style="font-size:0.72rem;">Cada lunes 08:00</div>
                    </div>
                    <div class="form-check form-switch p-0 m-0">
                        <input class="form-check-input" type="checkbox" checked />
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="fw-bold" style="font-size:0.82rem; color:#1e293b;">Ocupación mensual</div>
                        <div class="text-muted" style="font-size:0.72rem;">Día 1 de cada mes</div>
                    </div>
                    <div class="form-check form-switch p-0 m-0">
                        <input class="form-check-input" type="checkbox" checked />
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="fw-bold" style="font-size:0.82rem; color:#1e293b;">Satisfacción trimestral</div>
                        <div class="text-muted" style="font-size:0.72rem;">Cada 3 meses</div>
                    </div>
                    <div class="form-check form-switch p-0 m-0">
                        <input class="form-check-input" type="checkbox" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Cards selection
            const cards = document.querySelectorAll('.report-type-card');
            const descStrip = document.getElementById('reportDescStrip');

            cards.forEach(card => {
                card.addEventListener('click', function () {
                    cards.forEach(c => c.classList.remove('active'));
                    this.classList.add('active');
                    const radio = this.querySelector('input[type="radio"]');
                    if (radio) radio.checked = true;
                    descStrip.textContent = this.getAttribute('data-desc');
                });
            });

            // Metrics selection & count update
            const metrics = document.querySelectorAll('.chk-metric');
            const btnGenerate = document.getElementById('btnGenerate');
            const btnGenerateText = document.getElementById('btnGenerateText');
            const btnSubtext = document.getElementById('btnSubtext');
            const selectAllBtn = document.getElementById('selectAllBtn');

            function updateMetricsCount() {
                const checked = document.querySelectorAll('.chk-metric:checked').length;
                btnGenerateText.textContent = `Generar reporte (${checked} métricas)`;

                if (checked > 0) {
                    btnGenerate.classList.remove('disabled');
                    btnSubtext.style.display = 'none';
                } else {
                    btnGenerate.classList.add('disabled');
                    btnSubtext.style.display = 'block';
                    btnSubtext.textContent = 'Selecciona al menos una métrica para continuar';
                }
            }

            metrics.forEach(m => m.addEventListener('change', updateMetricsCount));

            selectAllBtn.addEventListener('click', function () {
                const allChecked = Array.from(metrics).every(m => m.checked);
                metrics.forEach(m => m.checked = !allChecked);
                selectAllBtn.textContent = allChecked ? 'Seleccionar todo' : 'Desmarcar todo';
                updateMetricsCount();
            });

            // Format buttons
            const fmtBtns = document.querySelectorAll('.btn-fmt');
            const inputFormato = document.getElementById('inputFormato');

            fmtBtns.forEach(btn => {
                btn.addEventListener('click', function () {
                    fmtBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    inputFormato.value = this.getAttribute('data-fmt');
                });
            });
        });
    </script>
}
