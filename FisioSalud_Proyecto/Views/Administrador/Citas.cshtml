@using FisioSalud_Proyecto.Helpers
@model FisioSalud_Proyecto.Models.Administrador.AdminCitasPageViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Gestion de Citas";
}
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold fs-4 text-dark m-0">Gestion de Citas</h2>
        <p class="text-muted small m-0">Administra todas las citas del sistema, cambia estados y revisa historial.</p>
    </div>
    <span class="badge bg-primary-subtle text-primary border px-3 py-2 rounded-pill">Total: @Model.Citas.Count citas</span>
</div>

<a asp-controller="AgendaGestion" asp-action="Index" class="btn btn-primary mb-3">Agendar / reprogramar citas</a>
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold mb-1">Buscar paciente</label>
                <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control form-control-sm" placeholder="Nombre o identificacion..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold mb-1">Estado</label>
                <select name="estado" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    <option value="SOLICITADA">Solicitada</option>
                    <option value="PENDIENTE_PAGO">Pendiente pago</option>
                    <option value="CONFIRMADA">Confirmada</option>
                    <option value="EN_ATENCION">En atencion</option>
                    <option value="ATENDIDA">Atendida</option>
                    <option value="CANCELADA">Cancelada</option>
                    <option value="NO_ASISTIO">No asistio</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold mb-1">Fecha desde</label>
                <input type="date" name="fechaDesde" value="@Model.FechaDesde?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold mb-1">Fecha hasta</label>
                <input type="date" name="fechaHasta" value="@Model.FechaHasta?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-sm btn-primary me-1"><i class="bi bi-funnel me-1"></i>Filtrar</button>
                <a asp-action="Citas" class="btn btn-sm btn-outline-secondary">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-4">
    @foreach (var stat in Model.Estadisticas)
    {
        <div class="col-6 col-md-3 col-xl-2">
            <div class="card border-0 shadow-sm rounded-3 text-center p-3">
                <div class="fw-bold text-@stat.Color fs-4">@stat.Cantidad</div>
                <div class="text-muted small">@stat.Etiqueta</div>
            </div>
        </div>
    }
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Paciente</th>
                        <th>Fisioterapeuta</th>
                        <th>Servicio</th>
                        <th>Fecha / Hora</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Citas.Any())
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted">No se encontraron citas.</td></tr>
                    }
                    else
                    {
                        foreach (var c in Model.Citas)
                        {
                            <tr>
                                <td class="ps-4 text-muted small fw-bold">#@c.CitaId</td>
                                <td>
                                    <div class="fw-bold" style="font-size:0.87rem;">@c.PacienteNombre</div>
                                    <div class="text-muted" style="font-size:0.74rem;">@c.PacienteIdentificacion</div>
                                </td>
                                <td style="font-size:0.83rem;">@c.FisioterapeutaNombre</td>
                                <td><span class="badge bg-light text-dark border small">@(c.ServicioNombre ?? "Sin servicio")</span></td>
                                <td>
                                    <div class="fw-bold" style="font-size:0.85rem;">@c.Fecha.ToString("dd/MM/yyyy")</div>
                                    <div class="text-muted small">@c.HoraInicio.ToString(@"hh\:mm")</div>
                                </td>
                                <td>
                                    <span class="badge bg-@CitaEstados.Css(c.Estado) px-2 py-1 rounded-pill">@CitaEstados.Etiqueta(c.Estado)</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2"
                                                data-bs-toggle="modal" data-bs-target="#mEC_@c.CitaId">
                                            <i class="bi bi-arrow-repeat"></i>
                                        </button>
                                        @if (c.Estado != CitaEstados.Cancelada && c.Estado != CitaEstados.Atendida)
                                        {
                                            <form asp-action="CancelarCitaAdmin" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="citaId" value="@c.CitaId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2"><i class="bi bi-x-circle"></i></button>
                                            </form>
                                        }
                                        @if (c.Estado == CitaEstados.Confirmada && c.Fecha < DateTime.Today)
                                        {
                                            <form asp-action="MarcarNoAsistio" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="citaId" value="@c.CitaId" />
                                                <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill px-2"><i class="bi bi-person-x"></i></button>
                                            </form>
                                        }
                                    </div>
                                    <div class="modal fade text-start" id="mEC_@c.CitaId" tabindex="-1">
                                        <div class="modal-dialog modal-sm modal-dialog-centered">
                                            <div class="modal-content">
                                                <form asp-action="CambiarEstadoCita" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="citaId" value="@c.CitaId" />
                                                    <div class="modal-header py-2"><h6 class="modal-title fw-bold">Estado Cita #@c.CitaId</h6><button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button></div>
                                                    <div class="modal-body py-2">
                                                        <select name="nuevoEstado" class="form-select form-select-sm mb-2">
                                                            <option value="SOLICITADA">Solicitada</option>
                                                            <option value="PENDIENTE_PAGO">Pendiente pago</option>
                                                            <option value="CONFIRMADA">Confirmada</option>
                                                            <option value="EN_ATENCION">En atencion</option>
                                                            <option value="ATENDIDA">Atendida</option>
                                                            <option value="CANCELADA">Cancelada</option>
                                                            <option value="NO_ASISTIO">No asistio</option>
                                                        </select>
                                                        <input type="text" name="observacion" class="form-control form-control-sm" placeholder="Motivo del cambio..." />
                                                    </div>
                                                    <div class="modal-footer py-2">
                                                        <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancelar</button>
                                                        <button type="submit" class="btn btn-sm btn-primary">Actualizar</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
