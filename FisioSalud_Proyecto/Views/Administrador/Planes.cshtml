@model FisioSalud_Proyecto.Models.Administrador.AdminPlanesPageViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Planes y Biblioteca";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold fs-4 text-dark m-0">Biblioteca y Catálogo Clínico</h2>
        <p class="text-muted small m-0">Gestiona los ejercicios terapéuticos, patologías y protocolos de atención.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Planes" asp-action="Index" class="btn btn-primary">Planes de pacientes</a>
        <button type="button" class="btn btn-outline-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modalNuevoEjercicioCat">
            <i class="bi bi-plus-circle me-1"></i> Nuevo Ejercicio
        </button>
        <button type="button" class="btn btn-outline-info rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modalNuevaPatologiaCat">
            <i class="bi bi-file-medical me-1"></i> Nueva Patología
        </button>
    </div>
</div>

<!-- KPI Cards -->
<div class="admin-kpi-grid mb-4">
    <div class="kpi-card">
        <div class="kpi-icon-box blue"><i class="bi bi-journal-medical"></i></div>
        <div>
            <div class="kpi-number">@Model.TotalPlanes</div>
            <div class="kpi-title">Protocolos registrados</div>
            <div class="kpi-sub blue">En la biblioteca clínica</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon-box cyan"><i class="bi bi-clipboard2-check-fill"></i></div>
        <div>
            <div class="kpi-number">@Model.UsosMes</div>
            <div class="kpi-title">Usos este mes</div>
            <div class="kpi-sub cyan">Motivos de consulta registrados</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon-box green"><i class="bi bi-heart-pulse-fill"></i></div>
        <div>
            <div class="kpi-number">@Model.TerapeutasActivos</div>
            <div class="kpi-title">Terapeutas activos</div>
            <div class="kpi-sub green">Aplicando protocolos</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon-box yellow"><i class="bi bi-activity"></i></div>
        <div>
            <div class="kpi-number">Activos</div>
            <div class="kpi-title">Módulo de Catálogo</div>
            <div class="kpi-sub yellow">Ejercicios & Patologías</div>
        </div>
    </div>
</div>

<div class="fisio-card mb-0">
    <!-- Tabs -->
    <div class="admin-tabs">
        <a asp-action="Planes" asp-route-tab="ejercicios" class="@(Model.Tab == "ejercicios" ? "active" : "")">
            <i class="bi bi-activity me-1"></i>Ejercicios y Protocolos
        </a>
        <a asp-action="Planes" asp-route-tab="tratamientos" class="@(Model.Tab == "tratamientos" ? "active" : "")">
            <i class="bi bi-clipboard2-pulse me-1"></i>Tratamientos
        </a>
    </div>

    @if (Model.Tab == "ejercicios" && Model.Ejercicios.Any())
    {
        <div class="plan-grid">
            @foreach (var e in Model.Ejercicios)
            {
                <div class="plan-card">
                    <div class="plan-icon"><i class="bi bi-activity"></i></div>
                    <div class="fw-bold mb-1">@e.Nombre</div>
                    <div class="text-muted mb-2 small">@(string.IsNullOrWhiteSpace(e.Descripcion) ? "Sin descripción" : e.Descripcion)</div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="small">@(e.DuracionMinutos.HasValue ? $"{e.DuracionMinutos} min" : "Sin duración")</span>
                        <span class="badge bg-@(e.Estado ? "success" : "secondary")">@(e.Estado ? "Activo" : "Inactivo")</span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-primary flex-grow-1" data-bs-toggle="modal" data-bs-target="#editarEjercicio_@e.EjercicioId">Editar</button>
                        <form asp-action="ToggleEjercicioCatalogo" method="post">
                            <input type="hidden" name="ejercicioId" value="@e.EjercicioId" />
                            <button type="submit" class="btn btn-sm btn-outline-@(e.Estado ? "danger" : "success")">@(e.Estado ? "Desactivar" : "Activar")</button>
                        </form>
                    </div>
                </div>
                <div class="modal fade" id="editarEjercicio_@e.EjercicioId" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
                        <form asp-action="GuardarEjercicioCatalogo" method="post">
                            <input type="hidden" name="EjercicioId" value="@e.EjercicioId" />
                            <input type="hidden" name="Estado" value="@e.Estado.ToString().ToLowerInvariant()" />
                            <div class="modal-header"><h5 class="modal-title fw-bold">Editar ejercicio</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                            <div class="modal-body">
                                <label class="form-label small fw-bold">Nombre</label><input name="Nombre" value="@e.Nombre" class="form-control mb-3" required />
                                <label class="form-label small fw-bold">Descripción</label><textarea name="Descripcion" class="form-control mb-3" rows="3">@e.Descripcion</textarea>
                                <label class="form-label small fw-bold">Duración (min)</label><input type="number" min="1" name="DuracionMinutos" value="@e.DuracionMinutos" class="form-control mb-3" />
                                <label class="form-label small fw-bold">Recomendaciones</label><textarea name="Recomendaciones" class="form-control" rows="2">@e.Recomendaciones</textarea>
                            </div>
                            <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-primary">Guardar</button></div>
                        </form>
                    </div></div>
                </div>
            }
        </div>
    }
    else if (Model.Tab == "tratamientos" && Model.Patologias.Any())
    {
        <div class="plan-grid">
            @foreach (var p in Model.Patologias)
            {
                <div class="plan-card">
                    <div class="plan-icon"><i class="bi bi-file-medical"></i></div>
                    <div class="fw-bold mb-1">@p.Nombre</div>
                    <div class="text-muted mb-3 small">@(string.IsNullOrWhiteSpace(p.Descripcion) ? "Sin descripción" : p.Descripcion)</div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge bg-@(p.Estado ? "success" : "secondary")">@(p.Estado ? "Activa" : "Inactiva")</span>
                        <form asp-action="TogglePatologia" method="post">
                            <input type="hidden" name="patologiaId" value="@p.PatologiaId" />
                            <button type="submit" class="btn btn-sm btn-outline-@(p.Estado ? "danger" : "success")">@(p.Estado ? "Desactivar" : "Activar")</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
    else if (Model.Tab == "_resumen" && Model.Planes.Any())
    {
        <div class="plan-grid">
            @foreach (var p in Model.Planes)
            {
                <div class="plan-card">
                    <div class="plan-icon">
                        <i class="bi @p.Icono"></i>
                    </div>
                    <div class="fw-bold mb-1" style="font-size:0.9rem;">@p.Titulo</div>
                    <div class="text-muted mb-2" style="font-size:0.75rem;">
                        <i class="bi bi-person me-1"></i>@p.Autor
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted" style="font-size:0.72rem;">
                            <i class="bi bi-clock me-1"></i>@p.Actualizado
                        </span>
                        <span class="status-badge activo">@p.Usos usos</span>
                    </div>
                </div>
            }
        </div>
    }
    else if ((Model.Tab == "ejercicios" && !Model.Ejercicios.Any()) || (Model.Tab == "tratamientos" && !Model.Patologias.Any()))
    {
        <div class="empty-state py-5">
            <i class="bi bi-journal-medical d-block fs-1 mb-3 opacity-30"></i>
            <p class="fw-semibold mb-1">La biblioteca está activa.</p>
            <p class="text-muted mb-3" style="font-size:0.85rem;">
                Utiliza los botones superiores para incorporar nuevos ejercicios y patologías al catálogo clínico general.
            </p>
        </div>
    }
</div>

<!-- Modal Nuevo Ejercicio -->
<div class="modal fade" id="modalNuevoEjercicioCat" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="GuardarEjercicioCatalogo" method="post">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Nuevo Ejercicio Terapéutico</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Nombre del Ejercicio</label>
                        <input type="text" name="Nombre" class="form-control" placeholder="ej. Estiramiento Isquiotibial" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Descripción</label>
                        <textarea name="Descripcion" class="form-control" rows="2" placeholder="Técnica de ejecución..."></textarea>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Duración estimada (min)</label>
                            <input type="number" name="DuracionMinutos" class="form-control" value="15" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Estado</label>
                            <select name="Estado" class="form-select">
                                <option value="true">Activo</option>
                                <option value="false">Inactivo</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Recomendaciones / Indicaciones</label>
                        <textarea name="Recomendaciones" class="form-control" rows="2" placeholder="Mantener la espalda recta..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-primary">Guardar Ejercicio</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Nueva Patología -->
<div class="modal fade" id="modalNuevaPatologiaCat" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="GuardarPatologia" method="post">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Nueva Patología Clínica</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Nombre de la Patología</label>
                        <input type="text" name="Nombre" class="form-control" placeholder="ej. Tendinitis rotuliana" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Descripción</label>
                        <textarea name="Descripcion" class="form-control" rows="3" placeholder="Síntomas y características clínicas..."></textarea>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="Estado" value="true" id="pat_new" checked />
                        <label class="form-check-label small fw-bold" for="pat_new">Patología Activa</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-info text-white">Guardar Patología</button>
                </div>
            </form>
        </div>
    </div>
</div>

