@model FisioSalud_Proyecto.Models.Clinical.EquiposPageViewModel
@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Equipos terapéuticos"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="fw-bold fs-4 mb-1">Equipos terapéuticos</h2><p class="text-muted mb-0">Inventario, disponibilidad y reservas de caminadoras.</p></div><button class="btn-fisio-primary" data-bs-toggle="modal" data-bs-target="#nuevoEquipo"><i class="bi bi-plus-lg"></i> Nuevo equipo</button></div>
<div class="row g-3 mb-4">@foreach(var e in Model.Equipos){<div class="col-md-4"><div class="fisio-card h-100"><div class="d-flex justify-content-between"><h5 class="fw-bold">@e.Nombre</h5><span class="status-badge @(e.EstadoOperativo == "DISPONIBLE" ? "activo" : "riesgo")">@e.EstadoOperativo</span></div><p class="text-muted small">@e.Codigo · @e.Tipo</p><div class="d-flex gap-1 flex-wrap">@foreach(var estado in new[]{"DISPONIBLE","MANTENIMIENTO","INACTIVO"}){<form asp-action="CambiarEstadoEquipo" method="post"><input type="hidden" name="equipoId" value="@e.EquipoId"/><input type="hidden" name="estado" value="@estado"/><button class="btn btn-sm btn-outline-secondary" disabled="@(e.EstadoOperativo == estado)">@estado</button></form>}</div></div></div>}</div>
<div class="fisio-card"><h5 class="fw-bold mb-3">Agenda de uso</h5><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Fecha</th><th>Equipo</th><th>Paciente</th><th>Fisioterapeuta</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var u in Model.Usos){<tr><td>@u.Fecha.ToString("dd/MM/yyyy") @u.HoraInicio.ToString(@"hh\:mm")</td><td>@u.Equipo?.Nombre</td><td>@u.Paciente?.NombreCompleto</td><td>@u.Fisioterapeuta?.NombreCompleto</td><td>@u.Estado</td><td>@if(u.Estado=="PROGRAMADO"){<form asp-action="CancelarUsoEquipo" method="post"><input type="hidden" name="usoEquipoId" value="@u.UsoEquipoId"/><button class="btn btn-sm btn-outline-danger">Cancelar</button></form>}</td></tr>} @if(!Model.Usos.Any()){<tr><td colspan="6" class="text-center text-muted py-4">Sin reservas registradas.</td></tr>}</tbody></table></div></div>
<div class="modal fade" id="nuevoEquipo" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form asp-action="GuardarEquipo" method="post"><div class="modal-header"><h5 class="fw-bold">Registrar equipo</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label">Nombre</label><input name="Nombre" class="form-control mb-3" required/><label class="form-label">Código</label><input name="Codigo" class="form-control mb-3" required/><input type="hidden" name="Tipo" value="CAMINADORA"/><input type="hidden" name="EstadoOperativo" value="DISPONIBLE"/><div class="row g-2"><div class="col"><label class="form-label">Velocidad máxima</label><input type="number" step="0.1" name="VelocidadMaxima" class="form-control"/></div><div class="col"><label class="form-label">Inclinación máxima</label><input type="number" step="0.1" name="InclinacionMaxima" class="form-control"/></div></div></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary">Guardar</button></div></form></div></div></div>
