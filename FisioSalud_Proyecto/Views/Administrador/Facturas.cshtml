@model FisioSalud_Proyecto.Models.Administrador.AdminFacturasPageViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Facturacion y Pagos";
}
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold fs-4 text-dark m-0">Facturacion y Pagos</h2>
        <p class="text-muted small m-0">Revisa, gestiona y concilia todos los cobros de la clinica.</p>
    </div>
</div>

<a asp-controller="Cobros" asp-action="Index" class="btn btn-primary mb-3">Revisar comprobantes enviados por clientes</a>
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 text-center">
            <div class="fw-bold text-success fs-4">@Model.TotalCobrado.ToString("C2")</div>
            <div class="text-muted small">Total cobrado</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 text-center">
            <div class="fw-bold text-warning fs-4">@Model.TotalPendiente.ToString("C2")</div>
            <div class="text-muted small">Pendiente</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 text-center">
            <div class="fw-bold text-danger fs-4">@Model.TotalCancelado.ToString("C2")</div>
            <div class="text-muted small">Cancelado</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 text-center">
            <div class="fw-bold text-primary fs-4">@Model.Facturas.Count</div>
            <div class="text-muted small">Total facturas</div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-3">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold mb-1">Buscar paciente</label>
                <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control form-control-sm" placeholder="Nombre o numero de factura..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold mb-1">Estado</label>
                <select name="estado" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    <option value="PENDIENTE">Pendiente</option>
                    <option value="PAGADO">Pagado</option>
                    <option value="CANCELADO">Cancelado</option>
                    <option value="REEMBOLSADO">Reembolsado</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold mb-1">Desde</label>
                <input type="date" name="fechaDesde" value="@Model.FechaDesde?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold mb-1">Hasta</label>
                <input type="date" name="fechaHasta" value="@Model.FechaHasta?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-sm btn-primary me-1"><i class="bi bi-funnel me-1"></i>Filtrar</button>
                <a asp-action="Facturas" class="btn btn-sm btn-outline-secondary">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4">Num. Factura</th>
                        <th>Paciente</th>
                        <th>Fisioterapeuta</th>
                        <th class="text-end">Monto</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th>Metodo Pago</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Facturas.Any())
                    {
                        <tr><td colspan="8" class="text-center py-5 text-muted">No se encontraron facturas.</td></tr>
                    }
                    else
                    {
                        foreach (var f in Model.Facturas)
                        {
                            <tr>
                                <td class="ps-4 fw-bold" style="font-size:0.85rem;">@f.NumeroFactura</td>
                                <td>
                                    <div class="fw-bold" style="font-size:0.85rem;">@f.PacienteNombre</div>
                                </td>
                                <td style="font-size:0.83rem;">@(f.FisioterapeutaNombre ?? "-")</td>
                                <td class="text-end fw-bold text-success">@f.Monto.ToString("C2")</td>
                                <td style="font-size:0.83rem;">@f.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @{
                                        var badgeColor = f.Estado switch {
                                            "PAGADO" => "success",
                                            "PENDIENTE" => "warning",
                                            "CANCELADO" => "danger",
                                            "REEMBOLSADO" => "info",
                                            _ => "secondary"
                                        };
                                    }
                                    <span class="badge bg-@badgeColor px-2 py-1 rounded-pill">@f.Estado</span>
                                </td>
                                <td style="font-size:0.83rem;">@(f.MetodoPago ?? "-")</td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-1">
                                        @if (f.Estado == "PENDIENTE")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-2"
                                                    data-bs-toggle="modal" data-bs-target="#modalPagoAdmin_@f.FacturaId" title="Registrar pago">
                                                <i class="bi bi-credit-card"></i>
                                            </button>
                                            <form asp-action="CancelarFactura" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="facturaId" value="@f.FacturaId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2" title="Cancelar factura"><i class="bi bi-x-circle"></i></button>
                                            </form>
                                        }
                                        @if (f.Estado == "PAGADO")
                                        {
                                            <form asp-action="ReembolsarFactura" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="facturaId" value="@f.FacturaId" />
                                                <button type="submit" class="btn btn-sm btn-outline-info rounded-pill px-2" title="Reembolsar"><i class="bi bi-arrow-counterclockwise"></i></button>
                                            </form>
                                        }
                                    </div>
                                    @if (f.Estado == "PENDIENTE")
                                    {
                                        <div class="modal fade text-start" id="modalPagoAdmin_@f.FacturaId" tabindex="-1">
                                            <div class="modal-dialog modal-sm modal-dialog-centered">
                                                <div class="modal-content">
                                                    <form asp-action="RegistrarPagoAdmin" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="facturaId" value="@f.FacturaId" />
                                                        <div class="modal-header py-2"><h6 class="modal-title fw-bold">Pago @f.NumeroFactura</h6><button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button></div>
                                                        <div class="modal-body py-2">
                                                            <div class="alert alert-info small py-1">Monto: <strong>@f.Monto.ToString("C2")</strong></div>
                                                            <label class="form-label small fw-bold">Metodo de pago</label>
                                                            <select name="metodoPago" class="form-select form-select-sm mb-2">
                                                                <option value="EFECTIVO">Efectivo</option>
                                                                <option value="TARJETA">Tarjeta</option>
                                                                <option value="TRANSFERENCIA">Transferencia</option>
                                                            </select>
                                                            <input type="text" name="referencia" class="form-control form-control-sm" placeholder="Referencia/comprobante" />
                                                        </div>
                                                        <div class="modal-footer py-2">
                                                            <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancelar</button>
                                                            <button type="submit" class="btn btn-sm btn-success">Registrar Pago</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
