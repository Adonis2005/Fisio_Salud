@model List<FisioSalud_Proyecto.Models.Entities.Servicio>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Gestión de Servicios y Precios";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold fs-4 text-dark m-0">Catálogo de Servicios y Precios</h2>
        <p class="text-muted small m-0">Administra los servicios clínicos ofrecidos y sus tarifas base.</p>
    </div>
    <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#modalNuevoServicio">
        <i class="bi bi-plus-lg me-1"></i> Nuevo Servicio
    </button>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Nombre del Servicio</th>
                        <th>Tipo</th>
                        <th>Precio Base</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No se han registrado servicios en el catálogo.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var s in Model)
                        {
                            <tr>
                                <td class="ps-4 font-mono fw-bold text-muted">#@s.ServicioId</td>
                                <td>
                                    <div class="fw-bold text-dark">@s.Nombre</div>
                                    <div class="text-muted small">@s.Descripcion</div>
                                </td>
                                <td><span class="badge bg-light text-dark border px-2 py-1">@s.Tipo</span></td>
                                <td class="fw-bold text-success fs-6">@s.Precio.ToString("C2")</td>
                                <td>
                                    @if (s.Estado)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border px-2 py-1 rounded-pill">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle" data-bs-toggle="modal" data-bs-target="#modalEditarServicio_@s.ServicioId">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <!-- Modal Editar -->
                                    <div class="modal fade text-start" id="modalEditarServicio_@s.ServicioId" tabindex="-1">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <form asp-action="GuardarServicio" method="post">
                                                    <input type="hidden" name="ServicioId" value="@s.ServicioId" />
                                                    <div class="modal-header">
                                                        <h5 class="modal-title fw-bold">Editar Servicio</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <div class="mb-3">
                                                            <label class="form-label small fw-bold">Nombre del Servicio</label>
                                                            <input type="text" name="Nombre" class="form-control" value="@s.Nombre" required />
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label small fw-bold">Descripción</label>
                                                            <textarea name="Descripcion" class="form-control" rows="2">@s.Descripcion</textarea>
                                                        </div>
                                                        <div class="row g-2 mb-3">
                                                            <div class="col-6">
                                                                <label class="form-label small fw-bold">Precio ($)</label>
                                                                <input type="number" step="0.01" name="Precio" class="form-control" value="@s.Precio" required />
                                                            </div>
                                                            <div class="col-6">
                                                                <label class="form-label small fw-bold">Tipo</label>
                                                                <select name="Tipo" class="form-select">
                                                                    <option value="TERAPIA" selected="@(s.Tipo == "TERAPIA")">TERAPIA</option>
                                                                    <option value="EVALUACION" selected="@(s.Tipo == "EVALUACION")">EVALUACION</option>
                                                                    <option value="CONSULTA" selected="@(s.Tipo == "CONSULTA")">CONSULTA</option>
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input" type="checkbox" name="Estado" value="true" id="st_@s.ServicioId" @(s.Estado ? "checked" : "") />
                                                            <label class="form-check-label small fw-bold" for="st_@s.ServicioId">Servicio Activo</label>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancelar</button>
                                                        <button type="submit" class="btn btn-sm btn-primary">Guardar Cambios</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Nuevo Servicio -->
<div class="modal fade" id="modalNuevoServicio" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="GuardarServicio" method="post">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Nuevo Servicio Clínico</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Nombre del Servicio</label>
                        <input type="text" name="Nombre" class="form-control" placeholder="ej. Fisioterapia Deportiva" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Descripción</label>
                        <textarea name="Descripcion" class="form-control" rows="2" placeholder="Detalles de la atención..."></textarea>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Precio ($)</label>
                            <input type="number" step="0.01" name="Precio" class="form-control" placeholder="35.00" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Tipo</label>
                            <select name="Tipo" class="form-select">
                                <option value="TERAPIA">TERAPIA</option>
                                <option value="EVALUACION">EVALUACION</option>
                                <option value="CONSULTA">CONSULTA</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="Estado" value="true" id="st_new" checked />
                        <label class="form-check-label small fw-bold" for="st_new">Servicio Activo</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-primary">Crear Servicio</button>
                </div>
            </form>
        </div>
    </div>
</div>
