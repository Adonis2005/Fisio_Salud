@model FisioSalud_Proyecto.Models.Administrador.AdminConfiguracionPageViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Configuración del Sistema";
}

<div class="row g-3">
    <!-- Columna Izquierda: Perfil y Menú de Configuración -->
    <div class="col-12 col-xl-3">
        <div class="settings-left-card">
            <!-- Profile Box -->
            <div class="settings-profile-header">
                <div class="avatar-lg mx-auto mb-2" style="background:#4A6CF7; width:64px; height:64px; font-size:1.2rem;">ER</div>
                <div class="fw-bold" style="font-size:0.95rem; color:#1e293b;">Admin Elena Ramírez</div>
                <div class="text-muted mb-2" style="font-size:0.75rem;">Administradora General</div>
                <span class="badge" style="background:#e0f2fe; color:#0284c7; font-size:0.7rem; font-weight:700; padding:0.3rem 0.8rem; border-radius:50px;">ADMIN</span>
            </div>

            <!-- Sub Navigation Menu -->
            <div class="d-flex flex-column gap-1">
                <a asp-action="Configuracion" asp-route-seccion="general" class="settings-nav-item @(Model.Seccion == "general" || string.IsNullOrEmpty(Model.Seccion) ? "active" : "")">
                    <i class="bi bi-sun"></i>
                    <span>General</span>
                </a>
                <a asp-action="Configuracion" asp-route-seccion="usuarios" class="settings-nav-item @(Model.Seccion == "usuarios" ? "active" : "")">
                    <i class="bi bi-people"></i>
                    <span>Usuarios y Roles</span>
                </a>
                <a asp-action="Configuracion" asp-route-seccion="seguridad" class="settings-nav-item @(Model.Seccion == "seguridad" ? "active" : "")">
                    <i class="bi bi-shield-lock"></i>
                    <span>Seguridad</span>
                </a>
                <a asp-action="Configuracion" asp-route-seccion="sistema" class="settings-nav-item @(Model.Seccion == "sistema" ? "active" : "")">
                    <i class="bi bi-bar-chart-steps"></i>
                    <span>Sistema y Respaldo</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Columna Derecha: Contenido de Configuración -->
    <div class="col-12 col-xl-9">
        <div class="fisio-card mb-0">
            @if (Model.Seccion == "usuarios")
            {
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold m-0" style="font-size:0.95rem; color:#1e293b;">Usuarios y Roles</h5>
                    <a asp-action="CrearUsuario" class="btn btn-sm text-white rounded-pill px-3 fw-bold" style="background:#3553c7; font-size:0.78rem;">
                        <i class="bi bi-plus-lg me-1"></i>Crear usuario
                    </a>
                </div>

                @if (Model.Usuarios != null && Model.Usuarios.Usuarios.Any())
                {
                    <div class="fisio-table-container">
                        <table class="fisio-table">
                            <thead>
                                <tr>
                                    <th>Usuario</th>
                                    <th>Correo</th>
                                    <th>Rol</th>
                                    <th>Último Acceso</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in Model.Usuarios.Usuarios)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold" style="font-size:0.85rem;">@u.Nombres @u.Apellidos</div>
                                            <span class="sub" style="font-size:0.72rem;">ID: #@u.UsuarioId</span>
                                        </td>
                                        <td style="font-size:0.78rem;">@u.Correo</td>
                                        <td><span class="status-badge nuevo">@u.Rol</span></td>
                                        <td style="font-size:0.75rem;">@(u.UltimoAcceso?.ToString("dd/MM/yyyy HH:mm") ?? "Sin acceso registrado")</td>
                                        <td>
                                            <span class="status-badge @(u.Estado ? "activo" : "pendiente")">
                                                @(u.Estado ? "Activo" : "Inactivo")
                                            </span>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <a asp-action="EditarUsuario" asp-route-id="@u.UsuarioId" class="icon-action" title="Editar">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <form asp-action="ToggleEstado" asp-route-id="@u.UsuarioId" method="post" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="icon-action" title="@(u.Estado ? "Desactivar" : "Activar")">
                                                        <i class="bi @(u.Estado ? "bi-person-x" : "bi-person-check")"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state py-4">
                        <i class="bi bi-people d-block fs-2 mb-2 opacity-40"></i>
                        <p class="mb-0" style="font-size:0.82rem;">No hay usuarios registrados en esta vista.</p>
                    </div>
                }
            }
            else
            {
                <!-- Sección General de la Clínica matching Image 3 -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold m-0" style="font-size:0.95rem; color:#1e293b;">Información de la Clínica</h5>
                    <button type="button" class="btn btn-sm text-white rounded-pill px-3 fw-bold" style="background:#3553c7; font-size:0.78rem;">
                        <i class="bi bi-check-lg me-1"></i>Guardar cambios
                    </button>
                </div>

                <!-- Gray Inner Box with 6 Fields -->
                <div class="info-gray-box mb-4">
                    <div>
                        <div class="info-field-label">Nombre de la clínica</div>
                        <div class="info-field-value">FisioSalud</div>
                    </div>
                    <div>
                        <div class="info-field-label">Correo de contacto</div>
                        <div class="info-field-value">contacto@fisiosalud.mx</div>
                    </div>
                    <div>
                        <div class="info-field-label">Teléfono</div>
                        <div class="info-field-value">+52 55 5000 0001</div>
                    </div>
                    <div>
                        <div class="info-field-label">Dirección</div>
                        <div class="info-field-value">Av. Insurgentes Sur 1234, CDMX</div>
                    </div>
                    <div>
                        <div class="info-field-label">Número de licencia</div>
                        <div class="info-field-value">SS-MEX-2024-00123</div>
                    </div>
                    <div>
                        <div class="info-field-label">Director médico</div>
                        <div class="info-field-value">Dr. Héctor Ramírez</div>
                    </div>
                </div>

                <!-- Section: HORARIO DE OPERACIÓN -->
                <div class="border-top pt-3">
                    <div class="fw-bold mb-3" style="font-size:0.75rem; color:#94a3b8; letter-spacing:0.5px; text-transform:uppercase;">HORARIO DE OPERACIÓN</div>
                    <div class="operating-hours-row">
                        <div class="hour-pill-box">Lun<br /><span style="font-size:0.72rem; font-weight:normal;">8–18h</span></div>
                        <div class="hour-pill-box">Mar<br /><span style="font-size:0.72rem; font-weight:normal;">8–18h</span></div>
                        <div class="hour-pill-box">Miérc<br /><span style="font-size:0.72rem; font-weight:normal;">8–18h</span></div>
                        <div class="hour-pill-box">Jue<br /><span style="font-size:0.72rem; font-weight:normal;">8–18h</span></div>
                        <div class="hour-pill-box">Vie<br /><span style="font-size:0.72rem; font-weight:normal;">8–18h</span></div>
                        <div class="hour-pill-box">Sáb<br /><span style="font-size:0.72rem; font-weight:normal;">9–14h</span></div>
                        <div class="hour-pill-box closed">Dom<br /><span style="font-size:0.72rem; font-weight:normal;">Cerrado</span></div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
