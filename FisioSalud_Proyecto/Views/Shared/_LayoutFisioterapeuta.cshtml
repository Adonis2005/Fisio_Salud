@inject FisioSalud_Proyecto.Data.FisioSaludDbContext PanelDb
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@{
    var panelUsuarioId = int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
    var panelCitas = await PanelDb.Citas.AsNoTracking().Where(c => c.FisioterapeutaId == panelUsuarioId && c.Fecha == DateTime.Today).Select(c => c.Estado).ToListAsync();
    var panelMensajes = await PanelDb.Mensajes.CountAsync(m => m.DestinatarioId == panelUsuarioId && !m.Leido);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FisioSalud</title>
    
    <!-- Bootstrap CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom Panel Stylesheet -->
    <link rel="stylesheet" href="~/css/fisioterapeuta-panel.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="fisio-theme">
    <div class="fisio-wrapper">
        @await Html.PartialAsync("_SidebarFisioterapeuta")

        <div class="fisio-content">
            <header class="fisio-navbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn-icon-round d-lg-none" id="toggleSidebar">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <div class="fisio-page-header">
                        <h1 class="fisio-page-title">@(ViewData["Title"] ?? "Mi Panel de Trabajo")</h1>
                        <p class="fisio-page-subtitle">@User.Identity.Name · @DateTime.Today.ToString("dd/MM/yyyy")</p>
                    </div>
                </div>

                <div class="fisio-navbar-actions">
                    <a asp-controller="Fisioterapeuta" asp-action="Pacientes" class="btn-icon-round" title="Buscar pacientes">
                        <i class="bi bi-search"></i>
                    </a>
                    <a asp-controller="Fisioterapeuta" asp-action="Mensajes" class="btn-icon-round" title="Mensajes sin leer: @panelMensajes">
                        <i class="bi bi-bell"></i>
                        @if(panelMensajes > 0) { <span class="notification-badge">@panelMensajes</span> }
                    </a>
                    <div class="citas-today-pill">
                        <span class="citas-today-dot"></span>
                        <span>@panelCitas.Count citas hoy · @panelCitas.Count(c => c == "ATENDIDA") completadas</span>
                    </div>
                    <a asp-controller="Ajustes" asp-action="Index" class="nav-user-avatar" title="Perfil">@string.Concat((User.Identity.Name ?? "").Split(' ').Where(s => s.Length > 0).Take(2).Select(s => s[0]))</a>
                </div>
            </header>

            <main class="fisio-main-body">
                @await Html.PartialAsync("_Alerts")
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.getElementById('toggleSidebar')?.addEventListener('click', function () {
            document.getElementById('fisioSidebar')?.classList.toggle('show');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
