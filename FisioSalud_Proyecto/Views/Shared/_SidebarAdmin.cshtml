@model FisioSalud_Proyecto.Models.Administrador.AdminChromeViewModel
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool IsActive(params string[] actions) => actions.Any(a => string.Equals(a, currentAction, StringComparison.OrdinalIgnoreCase));
}

<aside class="fisio-sidebar" id="fisioSidebar">
    <div class="fisio-sidebar-brand">
        <div class="fisio-brand-logo">FisioSalud</div>
        <div class="fisio-brand-sub">Panel de Administración</div>
    </div>

    <div class="fisio-user-badge">
        <div class="user-avatar-circle">@Model.Iniciales</div>
        <div class="user-info-text">
            <div class="user-name">Admin @Model.NombreAdmin</div>
            <div class="user-status">
                <span class="user-status-dot"></span> Administradora
            </div>
        </div>
    </div>

    <div class="sidebar-section-header">Gestión</div>
    <ul class="fisio-nav">
        <li class="fisio-nav-item">
            <a asp-controller="Administrador" asp-action="Dashboard" class="fisio-nav-link @(IsActive("Dashboard") ? "active" : "")">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Panel Admin</span>
            </a>
        </li>
        <li class="fisio-nav-item">
            <a asp-controller="Administrador" asp-action="Clinica" class="fisio-nav-link @(IsActive("Clinica") ? "active" : "")">
                <i class="bi bi-building"></i>
                <span>Clínica</span>
            </a>
        </li>
        <li class="fisio-nav-item">
            <a asp-controller="Administrador" asp-action="Terapeutas" class="fisio-nav-link @(IsActive("Terapeutas") ? "active" : "")">
                <i class="bi bi-heart-pulse-fill"></i>
                <span>Terapeutas</span>
            </a>
        </li>
        <li class="fisio-nav-item">
            <a asp-controller="Administrador" asp-action="Pacientes" class="fisio-nav-link @(IsActive("Pacientes", "CrearPaciente", "EditarPaciente") ? "active" : "")">
                <i class="bi bi-people-fill"></i>
                <span>Pacientes</span>
                @if (Model.PacientesRiesgo > 0)
                {
                    <span class="fisio-nav-badge">@Model.PacientesRiesgo</span>
                }
            </a>
        </li>
        <li class="fisio-nav-item">
            <a asp-controller="Administrador" asp-action="Planes" class="fisio-nav-link @(IsActive("Planes") ? "active" : "")">
                <i class="bi bi-journal-medical"></i>
                <span>Planes y Biblioteca</span>
            </a>
        </li>
    </ul>

    <div class="sidebar-section-header mt-2">Configuración Clínica</div>
    <ul class="fisio-nav">
        <li class="fisio-nav-item">
            <a asp-controller="Administrador" asp-action="Servicios" class="fisio-nav-link @(IsActive("Servicios", "GuardarServicio") ? "active" : "")">
                <i class="bi bi-currency-dollar"></i>
                <span>Servicios y Precios</span>
            </a>
        </li>
        <li class="fisio-nav-item">
            <a asp-controller="Administrador" asp-action="Disponibilidad" class="fisio-nav-link @(IsActive("Disponibilidad", "GuardarDisponibilidad") ? "active" : "")">
                <i class="bi bi-clock-fill"></i>
                <span>Disponibilidad</span>
            </a>
        </li>
        <li class="fisio-nav-item">
            <a asp-controller="Administrador" asp-action="Citas" class="fisio-nav-link @(IsActive("Citas") ? "active" : "")">
                <i class="bi bi-calendar-check-fill"></i>
                <span>Gestión de Citas</span>
            </a>
        </li>
        <li class="fisio-nav-item">
            <a asp-controller="Administrador" asp-action="Facturas" class="fisio-nav-link @(IsActive("Facturas") ? "active" : "")">
                <i class="bi bi-receipt-cutoff"></i>
                <span>Facturación</span>
            </a>
        </li>
    </ul>

    <div class="sidebar-section-header mt-2">Datos y sistema</div>
    <ul class="fisio-nav">
        <li class="fisio-nav-item">
            <a asp-controller="Administrador" asp-action="Reportes" class="fisio-nav-link @(IsActive("Reportes", "GenerarReporte") ? "active" : "")">
                <i class="bi bi-file-earmark-bar-graph-fill"></i>
                <span>Reportes</span>
            </a>
        </li>
        <li class="fisio-nav-item">
            <a asp-controller="Administrador" asp-action="Analitica" class="fisio-nav-link @(IsActive("Analitica") ? "active" : "")">
                <i class="bi bi-graph-up-arrow"></i>
                <span>Analítica</span>
            </a>
        </li>
        <li class="fisio-nav-item">
            <a asp-controller="Administrador" asp-action="Configuracion" class="fisio-nav-link @(IsActive("Configuracion", "Usuarios", "CrearUsuario", "EditarUsuario") ? "active" : "")">
                <i class="bi bi-gear-fill"></i>
                <span>Configuración</span>
            </a>
        </li>
    </ul>

    <div class="sidebar-tasks-box">
        <div class="sidebar-tasks-title">
            Alertas del sistema
            @if (Model.AlertasCount > 0)
            {
                <span class="fisio-nav-badge">@Model.AlertasCount</span>
            }
        </div>
        @if (Model.Alertas.Any())
        {
            foreach (var alerta in Model.Alertas.Take(2))
            {
                <div class="sidebar-task-item">
                    <span class="task-dot @alerta.CssDot"></span>
                    <span>@alerta.Mensaje</span>
                </div>
            }
        }
        else
        {
            <div class="sidebar-task-item">
                <span class="task-dot amber"></span>
                <span>Sin alertas clínicas por ahora.</span>
            </div>
        }
    </div>

    <form asp-controller="Auth" asp-action="Logout" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="fisio-logout-btn">
            <i class="bi bi-box-arrow-right"></i>
            <span>Cerrar sesión</span>
        </button>
    </form>
</aside>
