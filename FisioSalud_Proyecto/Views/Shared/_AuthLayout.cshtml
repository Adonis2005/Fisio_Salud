<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FisioSalud</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        espresso: '#3C2A21',
                        cream: '#FAF7F2',
                        terracotta: '#8C6A4A',
                        'cream-dark': '#F7F4EF',
                    },
                    fontFamily: {
                        serif: ['"Playfair Display"', 'Georgia', 'serif'],
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="~/css/fisiosalud.css" asp-append-version="true" />
</head>
<body class="font-sans text-espresso antialiased min-h-screen bg-cream overflow-x-hidden">
    <div class="flex min-h-screen w-full">
        <!-- Columna Izquierda -->
        <div class="hidden lg:flex lg:w-1/2 relative bg-espresso items-center justify-center overflow-hidden">
            <div class="absolute inset-0 bg-black/40 z-10"></div>
            <img src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80" alt="Fisioterapia" class="absolute inset-0 w-full h-full object-cover z-0" />
            
            <div class="relative z-20 text-center px-12 flex flex-col items-center w-full max-w-lg">
                <h1 class="font-serif text-5xl text-white mb-6">FisioSalud</h1>
                
                @if (IsSectionDefined("LeftColumnContent"))
                {
                    @RenderSection("LeftColumnContent", required: false)
                }
                else
                {
                    <h2 class="font-serif text-4xl text-white italic mb-4">Tu bienestar, nuestra prioridad</h2>
                    <p class="text-white/80 text-sm leading-relaxed mx-auto max-w-sm">
                        Accede a tu cuenta para gestionar tus citas, ver tu historial de tratamientos y comunicarte con tu fisioterapeuta.
                    </p>
                }
            </div>
        </div>

        <!-- Columna Derecha -->
        <div class="w-full lg:w-1/2 flex flex-col items-center justify-center p-8 sm:p-12 lg:p-20 relative bg-cream">
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
