@model ReservarCitaViewModel
@{
    ViewData["Title"] = "Contacto";
}

<section class="bg-espresso py-20 lg:py-24 text-center">
    <div class="container mx-auto px-6">
        <p class="text-xs font-semibold tracking-widest uppercase text-terracotta mb-4">Agenda tu cita</p>
        <h1 class="font-serif text-4xl lg:text-5xl text-white mb-6">Contáctanos</h1>
        <p class="text-white/70 max-w-2xl mx-auto text-sm lg:text-base leading-relaxed">
            Completa el formulario y nos pondremos en contacto contigo para confirmar tu cita.
        </p>
    </div>
</section>

<section class="bg-cream py-16 lg:py-24">
    <div class="container mx-auto px-6 lg:px-12">
        @if (TempData["Success"] != null)
        {
            <div class="mb-8 p-4 rounded-2xl bg-green-50 border border-green-200 text-green-800 text-sm flex items-center gap-2">
                <i class="bi bi-check-circle-fill"></i>
                @TempData["Success"]
            </div>
        }

        <div class="grid grid-cols-1 lg:grid-cols-5 gap-10">
            <div class="lg:col-span-3">
                <div class="bg-white rounded-3xl shadow-sm p-8 lg:p-10">
                    <h2 class="font-serif text-2xl text-espresso mb-2">Reserva tu cita</h2>
                    <p class="text-body-text text-sm mb-8">Completa los datos y te contactaremos para confirmar.</p>

                    <form asp-action="Reservar" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="mb-4 p-3 rounded-xl bg-red-50 text-red-700 text-sm"></div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                            <div>
                                <label asp-for="Nombre" class="form-label-fisio"></label>
                                <input asp-for="Nombre" class="form-input-fisio" placeholder="Tu nombre" />
                                <span asp-validation-for="Nombre" class="text-red-500 text-xs mt-1 block"></span>
                            </div>
                            <div>
                                <label asp-for="Apellido" class="form-label-fisio"></label>
                                <input asp-for="Apellido" class="form-input-fisio" placeholder="Tu apellido" />
                                <span asp-validation-for="Apellido" class="text-red-500 text-xs mt-1 block"></span>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                            <div>
                                <label asp-for="Email" class="form-label-fisio"></label>
                                <input asp-for="Email" class="form-input-fisio" placeholder="correo@ejemplo.com" />
                                <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
                            </div>
                            <div>
                                <label asp-for="Telefono" class="form-label-fisio"></label>
                                <input asp-for="Telefono" class="form-input-fisio" placeholder="+52 55 1234 5678" />
                                <span asp-validation-for="Telefono" class="text-red-500 text-xs mt-1 block"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Servicio" class="form-label-fisio"></label>
                            <select asp-for="Servicio" class="form-input-fisio">
                                <option value="">Seleccione un servicio</option>
                                @foreach (var servicio in ReservarCitaViewModel.ServiciosDisponibles)
                                {
                                    <option value="@servicio">@servicio</option>
                                }
                            </select>
                            <span asp-validation-for="Servicio" class="text-red-500 text-xs mt-1 block"></span>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                            <div>
                                <label asp-for="Fecha" class="form-label-fisio"></label>
                                <input asp-for="Fecha" type="date" class="form-input-fisio"
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="Fecha" class="text-red-500 text-xs mt-1 block"></span>
                            </div>
                            <div>
                                <label asp-for="Hora" class="form-label-fisio"></label>
                                <select asp-for="Hora" class="form-input-fisio">
                                    <option value="">Seleccione horario</option>
                                    <option value="08:00">08:00 AM</option>
                                    <option value="09:00">09:00 AM</option>
                                    <option value="10:00">10:00 AM</option>
                                    <option value="11:00">11:00 AM</option>
                                    <option value="12:00">12:00 PM</option>
                                    <option value="14:00">02:00 PM</option>
                                    <option value="15:00">03:00 PM</option>
                                    <option value="16:00">04:00 PM</option>
                                    <option value="17:00">05:00 PM</option>
                                    <option value="18:00">06:00 PM</option>
                                    <option value="19:00">07:00 PM</option>
                                </select>
                                <span asp-validation-for="Hora" class="text-red-500 text-xs mt-1 block"></span>
                            </div>
                        </div>

                        <div class="mb-6">
                            <label asp-for="Mensaje" class="form-label-fisio"></label>
                            <textarea asp-for="Mensaje" rows="4" class="form-input-fisio resize-none"
                                      placeholder="Cuéntanos sobre tu condición o consulta..."></textarea>
                            <span asp-validation-for="Mensaje" class="text-red-500 text-xs mt-1 block"></span>
                        </div>

                        <button type="submit"
                                class="w-full py-3.5 rounded-full bg-terracotta text-white font-medium hover:bg-terracotta/90 transition-all">
                            Solicitar Cita
                        </button>
                    </form>
                </div>
            </div>

            <div class="lg:col-span-2 space-y-6">
                <img src="https://images.unsplash.com/photo-1608571423902-eed4a5ad8108?auto=format&fit=crop&w=600&q=80"
                     alt="Ambiente relajante" class="service-img w-full h-48 rounded-3xl" />

                <div class="bg-white rounded-2xl shadow-sm p-6">
                    <h3 class="font-serif text-lg text-espresso mb-5">Información de contacto</h3>
                    <ul class="space-y-4 text-sm text-body-text">
                        <li class="flex items-start gap-3">
                            <i class="bi bi-geo-alt text-terracotta mt-0.5"></i>
                            <span>Av. Salud #123, Col. Bienestar, Ciudad de México</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <i class="bi bi-telephone text-terracotta"></i>
                            <span>+52 55 1234 5678</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <i class="bi bi-envelope text-terracotta"></i>
                            <span>contacto@fisiosalud.com</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <i class="bi bi-clock text-terracotta"></i>
                            <span>Lun - Sáb: 8:00 - 20:00</span>
                        </li>
                    </ul>
                </div>

                <div class="bg-terracotta rounded-2xl p-6 text-white">
                    <h3 class="font-serif text-lg mb-5">¿Por qué elegirnos?</h3>
                    <ul class="space-y-3 text-sm text-white/90">
                        <li class="flex items-center gap-2"><i class="bi bi-check-circle-fill"></i> Consulta de evaluación inicial</li>
                        <li class="flex items-center gap-2"><i class="bi bi-check-circle-fill"></i> Atención personalizada</li>
                        <li class="flex items-center gap-2"><i class="bi bi-check-circle-fill"></i> Equipo certificado</li>
                        <li class="flex items-center gap-2"><i class="bi bi-check-circle-fill"></i> Tecnología de vanguardia</li>
                        <li class="flex items-center gap-2"><i class="bi bi-check-circle-fill"></i> Resultados comprobados</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
