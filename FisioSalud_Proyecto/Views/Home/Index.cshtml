@{
    ViewData["Title"] = "Inicio";
    ViewData["NavVariant"] = "hero";
}

<section class="hero-bg relative min-h-screen flex items-center">
    <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/40 to-transparent"></div>

    <div class="relative container mx-auto px-6 lg:px-20 py-32 lg:py-0">
        <div class="max-w-xl">
            <span class="inline-block px-4 py-1.5 mb-6 text-xs font-semibold tracking-widest uppercase text-white/90 bg-white/10 backdrop-blur-sm rounded-md border border-white/10">
                Centro de Rehabilitación
            </span>

            <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-white leading-tight mb-6">
                Vuelve a Moverte sin Límites
            </h1>

            <p class="text-white/80 text-base lg:text-lg leading-relaxed mb-10 max-w-md">
                Fisioterapia especializada y rehabilitación física de alta calidad. Recupera tu bienestar con nuestro equipo de expertos.
            </p>

            <div class="flex flex-col sm:flex-row gap-4">
                <a asp-controller="Contacto" asp-action="Index"
                   class="inline-flex items-center justify-center px-8 py-3.5 rounded-full bg-terracotta text-white font-medium hover:bg-terracotta/90 transition-all shadow-lg shadow-black/20">
                    Agendar Cita
                </a>
                <a asp-controller="Servicios" asp-action="Index"
                   class="inline-flex items-center justify-center px-8 py-3.5 rounded-full bg-white/10 backdrop-blur-sm text-white font-medium border border-white/30 hover:bg-white/20 transition-all">
                    Ver Servicios
                </a>
            </div>
        </div>
    </div>
</section>
