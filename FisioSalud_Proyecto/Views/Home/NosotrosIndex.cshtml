@{
    ViewData["Title"] = "Sobre Nosotros";
}

<section class="bg-espresso py-20 lg:py-24 text-center">
    <div class="container mx-auto px-6">
        <p class="text-xs font-semibold tracking-widest uppercase text-terracotta mb-4">Quiénes somos</p>
        <h1 class="font-serif text-4xl lg:text-5xl text-white mb-6">Sobre FisioSalud</h1>
        <p class="text-white/70 max-w-2xl mx-auto text-sm lg:text-base leading-relaxed">
            Un equipo de profesionales comprometidos con devolverte el movimiento y la calidad de vida.
        </p>
    </div>
</section>

<section class="bg-cream py-16 lg:py-24">
    <div class="container mx-auto px-6 lg:px-12">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
            <div>
                <p class="text-xs font-semibold tracking-widest uppercase text-terracotta mb-4">Nuestra misión</p>
                <h2 class="font-serif text-3xl lg:text-4xl text-espresso mb-6">Más que fisioterapia, una familia</h2>
                <p class="text-body-text text-sm leading-relaxed mb-4">
                    Desde 2014, FisioSalud ha sido un referente en rehabilitación física en la Ciudad de México. Nacimos con la convicción de que cada paciente merece atención personalizada y tratamientos basados en evidencia científica.
                </p>
                <p class="text-body-text text-sm leading-relaxed mb-10">
                    Nuestro enfoque integral combina técnicas manuales avanzadas, tecnología de vanguardia y un trato humano excepcional para lograr los mejores resultados en el menor tiempo posible.
                </p>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="bg-white rounded-3xl p-6 shadow-sm">
                        <h3 class="font-semibold text-espresso mb-2">Empatía</h3>
                        <p class="text-body-text text-xs leading-relaxed">Escuchamos y comprendemos tu situación con calidez y respeto.</p>
                    </div>
                    <div class="bg-white rounded-3xl p-6 shadow-sm">
                        <h3 class="font-semibold text-espresso mb-2">Ciencia</h3>
                        <p class="text-body-text text-xs leading-relaxed">Aplicamos métodos respaldados por la evidencia clínica más reciente.</p>
                    </div>
                    <div class="bg-white rounded-3xl p-6 shadow-sm">
                        <h3 class="font-semibold text-espresso mb-2">Excelencia</h3>
                        <p class="text-body-text text-xs leading-relaxed">Buscamos los mejores resultados en cada sesión de tratamiento.</p>
                    </div>
                    <div class="bg-white rounded-3xl p-6 shadow-sm">
                        <h3 class="font-semibold text-espresso mb-2">Integridad</h3>
                        <p class="text-body-text text-xs leading-relaxed">Actuamos con honestidad y transparencia en todo momento.</p>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div class="col-span-1 row-span-2">
                    <img src="https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?auto=format&fit=crop&w=600&q=80"
                         alt="Terapia de rehabilitación" class="service-img w-full h-full min-h-[400px] rounded-3xl" />
                </div>
                <div>
                    <img src="https://images.unsplash.com/photo-1559757148-5c350d0d3c56?auto=format&fit=crop&w=400&q=80"
                         alt="Examen de rodilla" class="service-img w-full h-48 rounded-3xl" />
                </div>
                <div>
                    <img src="https://images.unsplash.com/photo-1599901860904-17e34fed7827?auto=format&fit=crop&w=400&q=80"
                         alt="Ejercicio con bandas" class="service-img w-full h-48 rounded-3xl" />
                </div>
            </div>
        </div>
    </div>
</section>

<section class="bg-white py-16 lg:py-24">
    <div class="container mx-auto px-6 lg:px-12">
        <div class="text-center mb-14">
            <p class="text-xs font-semibold tracking-widest uppercase text-terracotta mb-4">Especialistas</p>
            <h2 class="font-serif text-3xl lg:text-4xl text-espresso">Nuestro Equipo</h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="bg-cream rounded-3xl overflow-hidden shadow-sm">
                <img src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=400&q=80"
                     alt="Dra. Ana García" class="service-img w-full h-56" />
                <div class="p-6">
                    <h3 class="font-semibold text-espresso mb-1">Dra. Ana García</h3>
                    <p class="text-xs text-terracotta mb-3">Directora &amp; Fisioterapeuta Senior</p>
                    <p class="text-body-text text-xs leading-relaxed">15 años de experiencia en fisioterapia manual y rehabilitación neurológica.</p>
                </div>
            </div>
            <div class="bg-cream rounded-3xl overflow-hidden shadow-sm">
                <img src="https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&w=400&q=80"
                     alt="Dr. Carlos Méndez" class="service-img w-full h-56" />
                <div class="p-6">
                    <h3 class="font-semibold text-espresso mb-1">Dr. Carlos Méndez</h3>
                    <p class="text-xs text-terracotta mb-3">Fisioterapeuta Deportivo</p>
                    <p class="text-body-text text-xs leading-relaxed">Especialista en rehabilitación de lesiones deportivas y rendimiento atlético.</p>
                </div>
            </div>
            <div class="bg-cream rounded-3xl overflow-hidden shadow-sm">
                <img src="https://images.unsplash.com/photo-1622253692010-333f2da6031d?auto=format&fit=crop&w=400&q=80"
                     alt="Dr. Luis Torres" class="service-img w-full h-56" />
                <div class="p-6">
                    <h3 class="font-semibold text-espresso mb-1">Dr. Luis Torres</h3>
                    <p class="text-xs text-terracotta mb-3">Especialista en Electroterapia</p>
                    <p class="text-body-text text-xs leading-relaxed">Experto en tecnologías de electroterapia y modalidades físicas avanzadas.</p>
                </div>
            </div>
            <div class="bg-cream rounded-3xl overflow-hidden shadow-sm">
                <img src="https://images.unsplash.com/photo-1594824476967-48c8b964273f?auto=format&fit=crop&w=400&q=80"
                     alt="Dra. María López" class="service-img w-full h-56" />
                <div class="p-6">
                    <h3 class="font-semibold text-espresso mb-1">Dra. María López</h3>
                    <p class="text-xs text-terracotta mb-3">Pilates Terapéutico</p>
                    <p class="text-body-text text-xs leading-relaxed">Certificada en Pilates clínico y rehabilitación postural integrada.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="bg-cta-tan py-16 lg:py-20">
    <div class="container mx-auto px-6 text-center">
        <h2 class="font-serif text-3xl lg:text-4xl text-espresso mb-4">¿Listo para conocernos?</h2>
        <p class="text-body-text text-sm lg:text-base mb-8 max-w-xl mx-auto">
            Agenda tu consulta inicial y descubre por qué somos el centro de fisioterapia de confianza.
        </p>
        <a asp-controller="Contacto" asp-action="Index"
           class="inline-flex items-center justify-center px-10 py-3.5 rounded-full bg-espresso text-white font-medium hover:bg-espresso/90 transition-all">
            Agendar Cita
        </a>
    </div>
</section>
