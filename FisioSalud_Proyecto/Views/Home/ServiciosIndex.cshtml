@{
    ViewData["Title"] = "Servicios";
}

<section class="bg-espresso py-20 lg:py-24 text-center">
    <div class="container mx-auto px-6">
        <p class="text-xs font-semibold tracking-widest uppercase text-terracotta mb-4">Lo que ofrecemos</p>
        <h1 class="font-serif text-4xl lg:text-5xl text-white mb-6">Nuestros Servicios</h1>
        <p class="text-white/70 max-w-2xl mx-auto text-sm lg:text-base leading-relaxed">
            Tratamientos personalizados con técnicas avanzadas para acelerar tu recuperación y mejorar tu calidad de vida.
        </p>
    </div>
</section>

<section class="bg-cream py-16 lg:py-24">
    <div class="container mx-auto px-6 lg:px-12 space-y-16 lg:space-y-24">

        @* Servicio 1 *@
        <div class="bg-white rounded-3xl shadow-sm overflow-hidden">
            <div class="grid grid-cols-1 lg:grid-cols-2">
                <div class="h-64 lg:h-auto">
                    <img src="https://images.unsplash.com/photo-1544161515-4ab6ce6db874?auto=format&fit=crop&w=800&q=80"
                         alt="Fisioterapia Manual" class="service-img w-full h-full min-h-[280px]" />
                </div>
                <div class="p-8 lg:p-12 flex flex-col justify-center">
                    <h2 class="font-serif text-2xl lg:text-3xl text-espresso mb-4">Fisioterapia Manual</h2>
                    <p class="text-body-text text-sm leading-relaxed mb-6">
                        Técnicas manuales especializadas para tratar disfunciones musculoesqueléticas, aliviar el dolor y restaurar la movilidad articular de forma natural y efectiva.
                    </p>
                    <ul class="space-y-2 mb-6">
                        <li class="flex items-center gap-2 text-sm text-body-text"><i class="bi bi-check-circle-fill text-terracotta"></i> Alivio inmediato del dolor</li>
                        <li class="flex items-center gap-2 text-sm text-body-text"><i class="bi bi-check-circle-fill text-terracotta"></i> Mejora de la movilidad articular</li>
                        <li class="flex items-center gap-2 text-sm text-body-text"><i class="bi bi-check-circle-fill text-terracotta"></i> Tratamiento personalizado</li>
                    </ul>
                    <p class="text-xs text-body-text/60 mb-6">Duración: 45 - 60 min</p>
                    <a asp-controller="Contacto" asp-action="Index" class="inline-flex items-center justify-center self-start px-8 py-3 rounded-full bg-terracotta text-white text-sm font-medium hover:bg-terracotta/90 transition-all">Agendar Cita</a>
                </div>
            </div>
        </div>

        @* Servicio 2 *@
        <div class="bg-white rounded-3xl shadow-sm overflow-hidden">
            <div class="grid grid-cols-1 lg:grid-cols-2">
                <div class="p-8 lg:p-12 flex flex-col justify-center order-2 lg:order-1">
                    <h2 class="font-serif text-2xl lg:text-3xl text-espresso mb-4">Electroterapia</h2>
                    <p class="text-body-text text-sm leading-relaxed mb-6">
                        Aplicación de corrientes eléctricas terapéuticas para reducir la inflamación, acelerar la cicatrización de tejidos y aliviar el dolor crónico.
                    </p>
                    <ul class="space-y-2 mb-6">
                        <li class="flex items-center gap-2 text-sm text-body-text"><i class="bi bi-check-circle-fill text-terracotta"></i> Reducción de inflamación</li>
                        <li class="flex items-center gap-2 text-sm text-body-text"><i class="bi bi-check-circle-fill text-terracotta"></i> Estimulación muscular</li>
                        <li class="flex items-center gap-2 text-sm text-body-text"><i class="bi bi-check-circle-fill text-terracotta"></i> Acelera la recuperación</li>
                    </ul>
                    <p class="text-xs text-body-text/60 mb-6">Duración: 30 - 45 min</p>
                    <a asp-controller="Contacto" asp-action="Index" class="inline-flex items-center justify-center self-start px-8 py-3 rounded-full bg-terracotta text-white text-sm font-medium hover:bg-terracotta/90 transition-all">Agendar Cita</a>
                </div>
                <div class="h-64 lg:h-auto order-1 lg:order-2">
                    <img src="https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&w=800&q=80"
                         alt="Electroterapia" class="service-img w-full h-full min-h-[280px]" />
                </div>
            </div>
        </div>

        @* Servicio 3 *@
        <div class="bg-white rounded-3xl shadow-sm overflow-hidden">
            <div class="grid grid-cols-1 lg:grid-cols-2">
                <div class="h-64 lg:h-auto">
                    <img src="https://images.unsplash.com/photo-1517836357463-d25dfeac3438?auto=format&fit=crop&w=800&q=80"
                         alt="Rehabilitación Deportiva" class="service-img w-full h-full min-h-[280px]" />
                </div>
                <div class="p-8 lg:p-12 flex flex-col justify-center">
                    <h2 class="font-serif text-2xl lg:text-3xl text-espresso mb-4">Rehabilitación Deportiva</h2>
                    <p class="text-body-text text-sm leading-relaxed mb-6">
                        Programas especializados para atletas y personas activas que buscan recuperarse de lesiones y volver a su nivel óptimo de rendimiento.
                    </p>
                    <ul class="space-y-2 mb-6">
                        <li class="flex items-center gap-2 text-sm text-body-text"><i class="bi bi-check-circle-fill text-terracotta"></i> Retorno seguro al deporte</li>
                        <li class="flex items-center gap-2 text-sm text-body-text"><i class="bi bi-check-circle-fill text-terracotta"></i> Prevención de re-lesiones</li>
                        <li class="flex items-center gap-2 text-sm text-body-text"><i class="bi bi-check-circle-fill text-terracotta"></i> Mejora del rendimiento</li>
                    </ul>
                    <p class="text-xs text-body-text/60 mb-6">Duración: 60 - 90 min</p>
                    <a asp-controller="Contacto" asp-action="Index" class="inline-flex items-center justify-center self-start px-8 py-3 rounded-full bg-terracotta text-white text-sm font-medium hover:bg-terracotta/90 transition-all">Agendar Cita</a>
                </div>
            </div>
        </div>

        @* Servicio 4 *@
        <div class="bg-white rounded-3xl shadow-sm overflow-hidden">
            <div class="grid grid-cols-1 lg:grid-cols-2">
                <div class="p-8 lg:p-12 flex flex-col justify-center order-2 lg:order-1">
                    <h2 class="font-serif text-2xl lg:text-3xl text-espresso mb-4">Masajes Terapéuticos</h2>
                    <p class="text-body-text text-sm leading-relaxed mb-6">
                        Técnicas de masaje profundo y relajante para liberar tensiones musculares, mejorar la circulación y promover el bienestar general.
                    </p>
                    <ul class="space-y-2 mb-6">
                        <li class="flex items-center gap-2 text-sm text-body-text"><i class="bi bi-check-circle-fill text-terracotta"></i> Relajación muscular profunda</li>
                        <li class="flex items-center gap-2 text-sm text-body-text"><i class="bi bi-check-circle-fill text-terracotta"></i> Mejora de la circulación</li>
                        <li class="flex items-center gap-2 text-sm text-body-text"><i class="bi bi-check-circle-fill text-terracotta"></i> Reduce el estrés</li>
                    </ul>
                    <p class="text-xs text-body-text/60 mb-6">Duración: 45 - 60 min</p>
                    <a asp-controller="Contacto" asp-action="Index" class="inline-flex items-center justify-center self-start px-8 py-3 rounded-full bg-terracotta text-white text-sm font-medium hover:bg-terracotta/90 transition-all">Agendar Cita</a>
                </div>
                <div class="h-64 lg:h-auto order-1 lg:order-2">
                    <img src="https://images.unsplash.com/photo-1600334129128-685c5582fd8c?auto=format&fit=crop&w=800&q=80"
                         alt="Masajes Terapéuticos" class="service-img w-full h-full min-h-[280px]" />
                </div>
            </div>
        </div>

        @* Servicio 5 *@
        <div class="bg-white rounded-3xl shadow-sm overflow-hidden">
            <div class="grid grid-cols-1 lg:grid-cols-2">
                <div class="h-64 lg:h-auto">
                    <img src="https://images.unsplash.com/photo-1599901860904-17e34fed7827?auto=format&fit=crop&w=800&q=80"
                         alt="Pilates Terapéutico" class="service-img w-full h-full min-h-[280px]" />
                </div>
                <div class="p-8 lg:p-12 flex flex-col justify-center">
                    <h2 class="font-serif text-2xl lg:text-3xl text-espresso mb-4">Pilates Terapéutico</h2>
                    <p class="text-body-text text-sm leading-relaxed mb-6">
                        Ejercicios de bajo impacto enfocados en fortalecer el core, mejorar la postura y aumentar la flexibilidad de forma controlada y segura.
                    </p>
                    <ul class="space-y-2 mb-6">
                        <li class="flex items-center gap-2 text-sm text-body-text"><i class="bi bi-check-circle-fill text-terracotta"></i> Fortalece el core</li>
                        <li class="flex items-center gap-2 text-sm text-body-text"><i class="bi bi-check-circle-fill text-terracotta"></i> Mejora la postura</li>
                        <li class="flex items-center gap-2 text-sm text-body-text"><i class="bi bi-check-circle-fill text-terracotta"></i> Aumenta la flexibilidad</li>
                    </ul>
                    <p class="text-xs text-body-text/60 mb-6">Duración: 50 - 60 min</p>
                    <a asp-controller="Contacto" asp-action="Index" class="inline-flex items-center justify-center self-start px-8 py-3 rounded-full bg-terracotta text-white text-sm font-medium hover:bg-terracotta/90 transition-all">Agendar Cita</a>
                </div>
            </div>
        </div>

        @* Servicio 6 *@
        <div class="bg-white rounded-3xl shadow-sm overflow-hidden">
            <div class="grid grid-cols-1 lg:grid-cols-2">
                <div class="p-8 lg:p-12 flex flex-col justify-center order-2 lg:order-1">
                    <h2 class="font-serif text-2xl lg:text-3xl text-espresso mb-4">Neurorrehabilitación</h2>
                    <p class="text-body-text text-sm leading-relaxed mb-6">
                        Tratamiento especializado para pacientes con condiciones neurológicas, enfocado en recuperar funciones motoras y mejorar la independencia.
                    </p>
                    <ul class="space-y-2 mb-6">
                        <li class="flex items-center gap-2 text-sm text-body-text"><i class="bi bi-check-circle-fill text-terracotta"></i> Recuperación de funciones motoras</li>
                        <li class="flex items-center gap-2 text-sm text-body-text"><i class="bi bi-check-circle-fill text-terracotta"></i> Mejora del equilibrio</li>
                        <li class="flex items-center gap-2 text-sm text-body-text"><i class="bi bi-check-circle-fill text-terracotta"></i> Mayor independencia</li>
                    </ul>
                    <p class="text-xs text-body-text/60 mb-6">Duración: 60 min</p>
                    <a asp-controller="Contacto" asp-action="Index" class="inline-flex items-center justify-center self-start px-8 py-3 rounded-full bg-terracotta text-white text-sm font-medium hover:bg-terracotta/90 transition-all">Agendar Cita</a>
                </div>
                <div class="h-64 lg:h-auto order-1 lg:order-2">
                    <img src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=800&q=80"
                         alt="Neurorrehabilitación" class="service-img w-full h-full min-h-[280px]" />
                </div>
            </div>
        </div>
    </div>
</section>

<section class="bg-terracotta py-16 lg:py-20">
    <div class="container mx-auto px-6 text-center">
        <h2 class="font-serif text-3xl lg:text-4xl text-white mb-4">¿No sabes qué servicio necesitas?</h2>
        <p class="text-white/80 text-sm lg:text-base mb-8 max-w-xl mx-auto">
            Nuestros especialistas te ayudarán a encontrar el tratamiento ideal para tu condición.
        </p>
        <a asp-controller="Contacto" asp-action="Index"
           class="inline-flex items-center justify-center px-10 py-3.5 rounded-full bg-white text-espresso font-medium hover:bg-cream transition-all">
            Consultar con un Experto
        </a>
    </div>
</section>
