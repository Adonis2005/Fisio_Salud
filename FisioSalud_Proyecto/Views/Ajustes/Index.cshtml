@model FisioSalud_Proyecto.Controllers.AjustesViewModel
@{Layout=User.IsInRole("Administrador")?"_LayoutAdmin":User.IsInRole("Fisioterapeuta")?"_LayoutFisioterapeuta":"_LayoutCliente";ViewData["Title"]="Configuración";}
<section class="fisio-card fs-card mb-4"><h3>Mi perfil</h3><form asp-action="Perfil" method="post"><div class="row"><div class="col-md-6"><label>Nombres</label><input class="form-control mb-3" name="nombres" value="@Model.Nombres" maxlength="80" required/></div><div class="col-md-6"><label>Apellidos</label><input class="form-control mb-3" name="apellidos" value="@Model.Apellidos" maxlength="80" required/></div><div class="col-md-6"><label>Correo</label><input class="form-control mb-3" name="correo" type="email" value="@Model.Correo" required/></div><div class="col-md-6"><label>Teléfono</label><input class="form-control mb-3" name="telefono" value="@Model.Telefono" maxlength="20"/></div></div>
@if(User.IsInRole("Fisioterapeuta")){<label>Especialidad</label><input name="especialidad" class="form-control mb-3" value="@Model.Especialidad"/><label>Consultorio</label><input name="consultorio" class="form-control mb-3" value="@Model.Consultorio"/>}
<button class="btn btn-primary">Guardar perfil</button></form></section>
<section class="fisio-card fs-card mb-4"><h3>Seguridad</h3><form asp-action="Password" method="post"><label>Contraseña actual</label><input name="actual" type="password" class="form-control mb-3" required autocomplete="current-password"/><label>Nueva contraseña</label><input name="nueva" type="password" minlength="8" class="form-control mb-3" required autocomplete="new-password"/><label>Confirmar contraseña</label><input name="confirmacion" type="password" minlength="8" class="form-control mb-3" required autocomplete="new-password"/><button class="btn btn-primary">Cambiar contraseña</button></form><a asp-action="DescargarMisDatos" class="btn btn-outline-primary mt-3">Descargar mis datos</a></section>
<section class="fisio-card fs-card mb-4"><h3>@Model.ClinicaNombre</h3>
@if(User.IsInRole("Administrador")){<form asp-action="Clinica" method="post"><label>Nombre de la clínica</label><input name="nombre" value="@Model.ClinicaNombre" class="form-control mb-3" required/><label>Correo de contacto</label><input name="correo" type="email" value="@Model.ClinicaCorreo" class="form-control mb-3"/><label>Teléfono</label><input name="telefono" value="@Model.ClinicaTelefono" class="form-control mb-3"/><label>Dirección</label><input name="direccion" value="@Model.ClinicaDireccion" class="form-control mb-3"/><button class="btn btn-primary">Guardar clínica</button></form><div class="mt-3"><a asp-controller="Administrador" asp-action="Configuracion" asp-route-seccion="usuarios" class="btn btn-outline-primary">Usuarios y roles</a> <a asp-controller="Administrador" asp-action="Disponibilidad" class="btn btn-outline-primary">Horarios de atención</a> <a asp-controller="Administrador" asp-action="Reportes" class="btn btn-outline-primary">Exportar reportes</a></div>}
else{<p>@Model.ClinicaDireccion</p><p>@Model.ClinicaTelefono · @Model.ClinicaCorreo</p>}
</section>
