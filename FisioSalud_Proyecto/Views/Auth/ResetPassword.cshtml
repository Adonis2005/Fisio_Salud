@model ResetPasswordViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="auth-container">
    <div class="auth-card">
        <h2>Restablecer contraseña</h2>
        <p class="text-muted mb-4">Ingrese su nueva contraseña.</p>

        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />
            <div asp-validation-summary="ModelOnly" class="alert-fisio alert-error-fisio"></div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control form-control-fisio" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="form-control form-control-fisio" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-fisio btn-block">Restablecer contraseña</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
