@model FisioSalud_Proyecto.Models.Auth.ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Recuperar contraseña";
}

@section LeftColumnContent {
    <h2 class="font-serif text-4xl text-white italic mb-4">Recupera tu acceso</h2>
    <p class="text-white/80 text-sm leading-relaxed mx-auto max-w-sm mb-12">
        Te enviaremos un código de verificación al correo registrado para que puedas restablecer tu contraseña.
    </p>

    <div class="flex items-center justify-center space-x-2 sm:space-x-4 max-w-md mx-auto relative">
        <div class="flex flex-col items-center">
            <div class="w-8 h-8 rounded-full border border-white/60 flex items-center justify-center text-xs text-white/90 mb-2">1</div>
            <span class="text-[10px] text-white/80">Email</span>
        </div>
        <div class="w-8 sm:w-12 h-[1px] bg-white/20 mb-5"></div>
        <div class="flex flex-col items-center">
            <div class="w-8 h-8 rounded-full border border-white/20 flex items-center justify-center text-xs text-white/40 mb-2">2</div>
            <span class="text-[10px] text-white/40">Código</span>
        </div>
        <div class="w-8 sm:w-12 h-[1px] bg-white/20 mb-5"></div>
        <div class="flex flex-col items-center">
            <div class="w-8 h-8 rounded-full border border-white/20 flex items-center justify-center text-xs text-white/40 mb-2">3</div>
            <span class="text-[10px] text-white/40 text-center leading-tight">Nueva<br/>contraseña</span>
        </div>
        <div class="w-8 sm:w-12 h-[1px] bg-white/20 mb-5"></div>
        <div class="flex flex-col items-center">
            <div class="w-8 h-8 rounded-full border border-white/20 flex items-center justify-center text-xs text-white/40 mb-2">4</div>
            <span class="text-[10px] text-white/40">Listo</span>
        </div>
    </div>
}

<div class="w-full max-w-md">
    <a asp-action="Login" class="text-xs text-espresso/60 hover:text-terracotta transition-colors inline-flex items-center gap-2 mb-10">
        &larr; Volver al inicio de sesión
    </a>

    <div class="w-16 h-16 bg-espresso/5 rounded-2xl flex items-center justify-center mb-6">
        <i class="bi bi-envelope text-2xl text-espresso"></i>
    </div>

    <h2 class="text-3xl font-bold text-espresso mb-2">¿Olvidaste tu contraseña?</h2>
    <p class="text-sm text-espresso/70 mb-8">Ingresa el correo electrónico asociado a tu cuenta y te enviaremos un código de verificación.</p>

    @await Html.PartialAsync("_Alerts")

    <form asp-action="ForgotPassword" method="post" class="space-y-6">
        @Html.AntiForgeryToken()
        
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm bg-red-50 p-3 rounded-lg"></div>

        <div>
            <label asp-for="Correo" class="block text-xs font-semibold tracking-wider text-espresso/70 uppercase mb-2">Correo electrónico</label>
            <input asp-for="Correo" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-terracotta focus:ring focus:ring-terracotta/20 outline-none transition-all bg-white" placeholder="correo@ejemplo.com" />
            <span asp-validation-for="Correo" class="text-red-500 text-xs mt-1 block"></span>
        </div>

        <button type="submit" class="w-full bg-terracotta text-white font-medium py-3.5 rounded-full hover:bg-terracotta/90 transition-all shadow-lg shadow-terracotta/30">
            Enviar código de verificación
        </button>
    </form>

    <div class="mt-8 text-center text-sm text-espresso/70 border-b border-gray-200 pb-8">
        ¿Recuerdas tu contraseña? 
        <a asp-action="Login" class="font-semibold text-espresso hover:text-terracotta transition-colors ml-1">Inicia sesión</a>
    </div>
    
    <div class="mt-8 text-center">
        <a asp-controller="Home" asp-action="Index" class="text-xs text-espresso/60 hover:text-terracotta transition-colors inline-flex items-center gap-2">
            &larr; Volver al inicio
        </a>
    </div>
</div>
